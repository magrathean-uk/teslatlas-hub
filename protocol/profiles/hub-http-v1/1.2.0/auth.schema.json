{
  "$defs": {
    "claim": {
      "properties": {
        "access_token": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "device_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "expires_at_ms": {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "reason": {
          "enum": [
            "max_lifetime"
          ]
        }
      },
      "required": [
        "device_id",
        "access_token",
        "expires_at_ms"
      ],
      "type": "object"
    },
    "claim_request": {
      "additionalProperties": false,
      "properties": {
        "device_name": {
          "description": "A name of 1 to 128 UTF-8 bytes with no control character (U+0000 to U+001F, U+007F to U+009F). maxLength counts characters and cannot state the byte limit: a name of at most 128 characters can still be over 128 bytes, and is refused all the same (422, nothing consumed).",
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\u0000-\u001f\u007f-\u009f]"
          },
          "type": "string"
        },
        "secret": {
          "maxLength": 65536,
          "type": "string"
        }
      },
      "required": [
        "secret",
        "device_name"
      ],
      "type": "object"
    },
    "invitation": {
      "properties": {
        "endpoint": {
          "format": "uri",
          "maxLength": 4096,
          "type": "string"
        },
        "expiresAtMs": {
          "format": "int64",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "type": "integer"
        },
        "pairingId": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "pairingUri": {
          "maxLength": 16384,
          "pattern": "^teslatlas-hub://pair\\?",
          "type": "string"
        },
        "secret": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "tlsPin": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "pairingId",
        "secret",
        "expiresAtMs",
        "endpoint",
        "tlsPin",
        "pairingUri"
      ],
      "type": "object"
    }
  },
  "$id": "urn:teslatlas:hub-http-v1:1.2.0:auth",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
