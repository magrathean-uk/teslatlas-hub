{
  "$defs": {
    "hint": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rebase_required"
        },
        "reason": {
          "const": "compacted"
        },
        "replacement": {
          "additionalProperties": false,
          "properties": {
            "chunks": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "chunk_index": {
                    "maximum": 1770,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "pack": {
                    "additionalProperties": false,
                    "properties": {
                      "compressed_bytes": {
                        "maximum": 16777216,
                        "minimum": 1,
                        "type": "integer"
                      },
                      "object_name": {
                        "pattern": "^[a-z0-9][a-z0-9._/-]{0,1023}$",
                        "type": "string"
                      },
                      "sha256": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "object_name",
                      "sha256",
                      "compressed_bytes"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "chunk_index",
                  "pack"
                ],
                "type": "object"
              },
              "maxItems": 1771,
              "minItems": 1,
              "type": "array"
            },
            "manifest_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "manifest_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "receipt_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "schema_version": {
              "const": "2.2"
            },
            "sequence": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "manifest_id",
            "receipt_id",
            "manifest_sha256",
            "sequence",
            "schema_version",
            "chunks"
          ],
          "type": "object"
        },
        "requested_base": {
          "additionalProperties": false,
          "properties": {
            "manifest_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "manifest_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "receipt_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "schema_version": {
              "const": "2.2"
            },
            "sequence": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "manifest_id",
            "receipt_id",
            "manifest_sha256",
            "sequence",
            "schema_version"
          ],
          "type": "object"
        },
        "retry_request": {
          "additionalProperties": false,
          "properties": {
            "accepted_changed_set_formats": {
              "maxItems": 1,
              "minItems": 1,
              "prefixItems": [
                {
                  "const": "teslatlas-physical-v3-delta-v1"
                }
              ],
              "type": "array"
            },
            "base_manifest_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "base_manifest_schema": {
              "const": "2.2"
            },
            "base_manifest_sha256": {
              "pattern": "^[0-9a-f]{64}$",
