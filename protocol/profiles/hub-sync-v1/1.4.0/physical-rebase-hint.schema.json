                  "minimum": 1,
                  "type": "integer"
                },
                "vehicle_id": {
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                }
              },
              "required": [
                "installation_id",
                "account_id",
                "vehicle_id",
                "generation",
                "selected_car_id"
