{
  "$defs": {
    "request": {
      "additionalProperties": false,
      "properties": {
        "accepted_changed_set_formats": {
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "const": "teslatlas-physical-v3-delta-v1"
            }
          ],
          "type": "array"
        },
        "base_manifest_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "base_manifest_schema": {
          "const": "2.2"
        },
        "base_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "base_receipt_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "from_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "schema_version_range": {
          "additionalProperties": false,
          "properties": {
            "maximum": {
              "const": "2.2"
            },
            "minimum": {
              "const": "2.2"
            }
          },
          "required": [
            "minimum",
            "maximum"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "account_id": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "generation": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "installation_id": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "selected_car_id": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "vehicle_id": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "required": [
            "installation_id",
            "account_id",
            "vehicle_id",
            "generation",
            "selected_car_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "source",
        "base_receipt_id",
        "base_manifest_id",
        "base_manifest_sha256",
        "base_manifest_schema",
        "from_sequence",
        "schema_version_range",
        "accepted_changed_set_formats"
      ],
      "type": "object"
    }
  },
  "$id": "urn:teslatlas:hub-sync-v1:1.4.0:request",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
