{
  "components": {
    "securitySchemes": {
      "pairedBearer": {
        "bearerFormat": "opaque paired bearer",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Teslatlas changes-since",
    "version": "1.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/packs/sha256/{object_name}": {
      "get": {
        "operationId": "syncPack",
        "parameters": [
          {
            "in": "path",
            "name": "object_name",
            "required": true,
            "schema": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "application/vnd.teslatlas.prepared+sqlite+zstd;version=1": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "pack bytes"
          },
          "206": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "application/vnd.teslatlas.prepared+sqlite+zstd;version=1": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "single byte range"
          },
          "401": {
            "content": {},
            "description": "empty authentication failure"
          },
          "404": {
            "content": {},
            "description": "empty missing pack"
          }
        },
        "security": [
          {
            "pairedBearer": []
          }
        ]
      }
    },
    "/v1/vehicles/{vehicle_id}/sync/changes-since": {
      "post": {
        "operationId": "changesSince",
        "parameters": [
          {
            "in": "path",
            "name": "vehicle_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "changes-since-request.schema.json#/$defs/request"
              }
            }
          },
          "required": true,
          "x-max-body-bytes": 8192
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "changed-set-receipt.schema.json#/$defs/receipt"
                    },
                    {
                      "$ref": "noop.schema.json#/$defs/receipt"
                    }
                  ]
                }
              }
            },
            "description": "signed changed-set or no-op receipt",
            "x-max-body-bytes": 2097152
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "sync-error.schema.json#/$defs/error"
                }
              }
            },
            "description": "invalid JSON request body",
            "x-max-body-bytes": 2097152
          },
          "401": {
            "content": {},
            "description": "missing, invalid, expired, or revoked paired bearer"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "sync-error.schema.json#/$defs/error"
                }
              }
            },
            "description": "vehicle is not available to this pairing",
            "x-max-body-bytes": 2097152
          },
          "406": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "sync-error.schema.json#/$defs/error"
                }
              }
            },
            "description": "schema range has no supported version; Cache-Control: no-store",
            "headers": {
              "Cache-Control": {
                "description": "Required cache prohibition.",
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "x-max-body-bytes": 2097152
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "rebase-hint.schema.json#/$defs/hint"
                }
              }
            },
            "description": "signed rebase hint after compaction",
            "x-max-body-bytes": 2097152
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "sync-error.schema.json#/$defs/error"
                }
              }
            },
            "description": "request body exceeds 8192 bytes",
            "x-max-body-bytes": 2097152
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "sync-error.schema.json#/$defs/error"
                }
              }
            },
            "description": "request violates the schema, reverses the range, excludes the base schema, or names a base receipt unknown to this vehicle",
            "x-max-body-bytes": 2097152
          }
        },
        "security": [
          {
            "pairedBearer": []
          }
        ]
      }
    },
    "/v1/vehicles/{vehicle_id}/sync/manifest": {
      "get": {
        "operationId": "syncManifest",
        "parameters": [
          {
            "in": "path",
            "name": "vehicle_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          {
            "description": "Exact, single profile selector for the 1.3 bootstrap representation. A missing, duplicated, or different explicit selector/companion returns empty no-store 406. Without any profile selector, the request remains legacy SyncManifest negotiation.",
            "in": "header",
            "name": "x-teslatlas-sync-profile",
            "required": true,
            "schema": {
              "const": "hub-sync-v1@1.3.0"
            }
          },
          {
            "description": "Exact, single schema companion for the explicit 1.3 selector.",
            "in": "header",
            "name": "x-teslatlas-supported-schemas",
            "required": true,
            "schema": {
              "const": "2.1,2.2"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "sync-manifest.schema.json#/$defs/manifest"
                }
              }
            },
            "description": "signed manifest",
            "x-max-body-bytes": 2097152
          },
          "401": {
            "content": {},
            "description": "empty authentication failure"
          },
          "406": {
            "content": {},
            "description": "empty unavailable or malformed explicit bootstrap negotiation response with Cache-Control: no-store",
            "headers": {
              "Cache-Control": {
                "description": "Required cache prohibition.",
                "schema": {
                  "const": "no-store"
                }
              }
            }
          }
        },
        "security": [
          {
            "pairedBearer": []
          }
        ]
      }
    },
    "/v1/vehicles/{vehicle_id}/sync/noop": {
      "get": {
        "operationId": "syncNoop",
        "parameters": [
          {
            "in": "path",
            "name": "vehicle_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "noop.schema.json#/$defs/receipt"
                }
              }
            },
            "description": "signed no-op receipt",
            "x-max-body-bytes": 2097152
          },
          "401": {
            "content": {},
            "description": "empty authentication failure"
          },
          "406": {
            "content": {},
            "description": "empty unavailable response with Cache-Control: no-store",
            "headers": {
              "Cache-Control": {
                "description": "Required cache prohibition.",
                "schema": {
                  "const": "no-store"
                }
              }
            }
          }
        },
        "security": [
          {
            "pairedBearer": []
          }
        ]
      }
    },
    "/v1/vehicles/{vehicle_id}/sync/prepared-artefacts/{artifact_id}": {
      "get": {
        "operationId": "preparedArtefact",
        "parameters": [
          {
            "in": "path",
            "name": "vehicle_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "prepared-artefact.schema.json#/$defs/receipt"
                }
              }
            },
            "description": "signed map-month-only teslatlas-prepared-v1 receipt",
            "x-max-body-bytes": 2097152
          },
          "401": {
            "content": {},
            "description": "empty authentication failure"
          },
          "404": {
            "content": {},
            "description": "empty missing artefact"
          }
        },
        "security": [
          {
            "pairedBearer": []
          }
        ]
      }
    },
    "/v1/vehicles/{vehicle_id}/sync/signing-keys": {
      "get": {
        "operationId": "syncSigningKeys",
        "parameters": [
          {
            "in": "path",
            "name": "vehicle_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "signing-keys.schema.json#/$defs/document"
                }
              }
            },
            "description": "vehicle-bound signing keys over the authenticated paired channel; Cache-Control: no-store",
            "headers": {
              "Cache-Control": {
                "description": "Required cache prohibition.",
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "x-max-body-bytes": 2097152
          },
          "401": {
            "content": {},
            "description": "empty authentication failure"
          },
          "404": {
            "content": {},
            "description": "empty unknown vehicle"
          }
        },
        "security": [
          {
            "pairedBearer": []
          }
        ]
      }
    }
  }
}
