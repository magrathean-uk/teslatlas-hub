{
  "$defs": {
    "receipt": {
      "additionalProperties": false,
      "properties": {
        "base_manifest_schema": {
          "enum": [
            "2.1",
            "2.2"
          ],
          "type": "string"
        },
        "base_receipt_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "changed_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "from_sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "manifest_schema": {
          "enum": [
            "2.1",
            "2.2"
          ],
          "type": "string"
        },
        "pack": {
          "additionalProperties": false,
          "properties": {
            "compressed_bytes": {
              "maximum": 16777216,
              "minimum": 1,
              "type": "integer"
            },
            "object_name": {
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,1023}$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "object_name",
            "sha256",
            "compressed_bytes"
          ],
          "type": "object"
        },
        "receipt_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "signature": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "signature": {
              "pattern": "^[A-Za-z0-9+/]{86}==$",
              "type": "string"
            },
            "signed_payload_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "signed_payload_sha256",
            "signature"
          ],
          "type": "object"
        },
        "to_sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "vehicle_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "vehicle_id",
        "base_receipt_id",
        "base_manifest_schema",
        "from_sequence",
        "to_sequence",
        "manifest_schema",
        "changed_set_sha256",
        "pack",
        "signature"
      ],
      "type": "object"
    }
  },
  "$id": "urn:teslatlas:hub-sync-v1:1.3.0:changed-set-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
