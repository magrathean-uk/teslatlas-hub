{
  "$defs": {
    "map_month": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "resolution": {
              "const": "readyData"
            },
            "tile_count": {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "resolution": {
              "const": "readyEmpty"
            },
            "tile_count": {
              "const": 0
            }
          }
        }
      ],
      "properties": {
        "drive_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "from_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "month": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "type": "string"
        },
        "reason": {
          "const": "changed"
        },
        "resolution": {
          "enum": [
            "readyData",
            "readyEmpty"
          ]
        },
        "tile_count": {
          "maximum": 4096,
          "minimum": 0,
          "type": "integer"
        },
        "to_ms": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "month",
        "from_ms",
        "to_ms",
        "resolution",
        "drive_count",
        "tile_count",
        "reason"
      ],
      "type": "object"
    },
    "receipt": {
      "additionalProperties": false,
      "properties": {
        "algorithm_version": {
          "maxLength": 128,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "artifact_schema_version": {
          "const": 1
        },
        "artifact_type": {
          "const": "map_months"
        },
        "dirty_spans": {
          "additionalProperties": false,
          "properties": {
            "map_months": {
              "items": {
                "$ref": "#/$defs/map_month"
              },
              "maxItems": 120,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "map_months"
          ],
          "type": "object"
        },
        "generation": {
          "additionalProperties": false,
          "properties": {
            "generated_at_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "generation_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            }
          },
          "required": [
            "generation_id",
            "generated_at_ms"
          ],
          "type": "object"
        },
        "map_style": {
          "const": "route-stroke-v8-opaque"
        },
        "pack": {
          "additionalProperties": false,
          "properties": {
            "compressed_bytes": {
              "maximum": 16777216,
              "minimum": 1,
              "type": "integer"
            },
            "media_type": {
              "const": "application/vnd.teslatlas.prepared+sqlite+zstd;version=1"
            },
            "object_name": {
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,1023}$",
              "type": "string"
            },
            "payload": {
              "const": "teslatlas-prepared-v1"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "uncompressed_bytes": {
              "maximum": 67108864,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "object_name",
            "sha256",
            "compressed_bytes",
            "payload",
            "media_type",
            "uncompressed_bytes"
          ],
          "type": "object"
        },
        "payload": {
          "const": "teslatlas-prepared-v1"
        },
        "scope": {
          "const": "map_months"
        },
        "signature": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "signature": {
              "pattern": "^[A-Za-z0-9+/]{86}==$",
              "type": "string"
            },
            "signed_payload_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "signed_payload_sha256",
            "signature"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "input_manifest_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "input_manifest_schema": {
              "enum": [
                "2.1",
                "2.2"
              ],
              "type": "string"
            },
            "input_receipt_id": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "input_sequence": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "kind": {
              "const": "hub_compute"
            }
          },
          "required": [
            "kind",
            "input_manifest_id",
            "input_receipt_id",
            "input_manifest_schema",
            "input_sequence"
          ],
          "type": "object"
        },
        "tile_geometry_version": {
          "const": "raster-v9-rounded-tile-px"
        },
        "units": {
          "additionalProperties": false,
          "properties": {
            "coordinates": {
              "const": "wgs84_degrees"
            },
            "distance": {
              "const": "km"
            },
            "time": {
              "const": "ms"
            }
          },
          "required": [
            "distance",
            "time",
            "coordinates"
          ],
          "type": "object"
        },
        "vehicle_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "window": {
          "additionalProperties": false,
          "properties": {
            "from_ms": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "to_ms": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "from_ms",
            "to_ms"
          ],
          "type": "object"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "payload",
        "scope",
        "map_style",
        "tile_geometry_version",
        "artifact_schema_version",
        "vehicle_id",
        "source",
        "window",
        "generation",
        "units",
        "algorithm_version",
        "dirty_spans",
        "pack",
        "signature"
      ],
      "type": "object"
    }
  },
  "$id": "urn:teslatlas:hub-sync-v1:1.3.0:prepared-artefact",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
