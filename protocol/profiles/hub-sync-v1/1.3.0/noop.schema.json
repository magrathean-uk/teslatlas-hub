{
  "$defs": {
    "receipt": {
      "additionalProperties": false,
      "properties": {
        "base_receipt_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "kind": {
          "const": "no_op"
        },
        "manifest_schema": {
          "enum": [
            "2.1",
            "2.2"
          ],
          "type": "string"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "signature": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "signature": {
              "pattern": "^[A-Za-z0-9+/]{86}==$",
              "type": "string"
            },
            "signed_payload_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "signed_payload_sha256",
            "signature"
          ],
          "type": "object"
        },
        "vehicle_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "vehicle_id",
        "base_receipt_id",
        "sequence",
        "manifest_schema",
        "signature"
      ],
      "type": "object"
    }
  },
  "$id": "urn:teslatlas:hub-sync-v1:1.3.0:noop",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
