          "properties": {
            "compressed_bytes": {
              "maximum": 16777216,
              "minimum": 1,
              "type": "integer"
            },
            "object_name": {
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,1023}$",
              "type": "string"
