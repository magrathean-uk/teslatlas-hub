{
  "$defs": {
    "manifest": {
      "oneOf": [
        {
          "$ref": "#/$defs/schema_2_1"
        },
        {
          "$ref": "#/$defs/schema_2_2"
        }
      ]
    },
    "schema_2_1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "snapshot"
        },
        "manifest_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "pack": {
          "additionalProperties": false,
          "properties": {
            "compressed_bytes": {
              "maximum": 16777216,
              "minimum": 8388608,
              "type": "integer"
            },
            "object_name": {
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,1023}$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "object_name",
            "sha256",
            "compressed_bytes"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": "2.1"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "signature": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "signature": {
              "pattern": "^[A-Za-z0-9+/]{86}==$",
              "type": "string"
            },
            "signed_payload_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "signed_payload_sha256",
            "signature"
          ],
          "type": "object"
        },
        "vehicle_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "vehicle_id",
        "kind",
        "schema_version",
        "sequence",
        "pack",
        "signature"
      ],
      "type": "object"
    },
    "schema_2_2": {
      "additionalProperties": false,
      "properties": {
        "chunks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "chunk_index": {
                "maximum": 4095,
                "minimum": 0,
                "type": "integer"
              },
              "pack": {
                "additionalProperties": false,
                "properties": {
                  "compressed_bytes": {
                    "maximum": 16777216,
                    "minimum": 8388608,
                    "type": "integer"
                  },
                  "object_name": {
                    "pattern": "^[a-z0-9][a-z0-9._/-]{0,1023}$",
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "object_name",
                  "sha256",
                  "compressed_bytes"
                ],
                "type": "object"
              }
            },
            "required": [
              "chunk_index",
              "pack"
            ],
            "type": "object"
          },
          "maxItems": 4096,
          "minItems": 2,
          "type": "array"
        },
        "kind": {
          "const": "snapshot"
        },
        "manifest_id": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "schema_version": {
          "const": "2.2"
        },
        "sequence": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "signature": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "signature": {
              "pattern": "^[A-Za-z0-9+/]{86}==$",
              "type": "string"
            },
            "signed_payload_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "key_id",
            "signed_payload_sha256",
            "signature"
          ],
          "type": "object"
        },
        "vehicle_id": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "vehicle_id",
        "kind",
        "schema_version",
        "sequence",
        "chunks",
        "signature"
      ],
      "type": "object"
    }
  },
  "$id": "urn:teslatlas:hub-sync-v1:1.1.0:sync-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
