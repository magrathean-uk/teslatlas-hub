{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teslatlas:protocol:schema:discovery:1.2.0",
  "title": "Teslatlas Hub discovery document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hub_id",
    "protocol",
    "capabilities",
    "endpoints",
    "limits"
  ],
  "properties": {
    "hub_id": {
      "type": "string",
      "format": "uri",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "endpoints": {
      "$ref": "#/$defs/endpoints"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_version",
        "supported_versions",
        "minimum_client_version",
        "version_header",
        "selection"
      ],
      "properties": {
        "current_version": {
          "$ref": "#/$defs/semver"
        },
        "supported_versions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semver"
          }
        },
        "minimum_client_version": {
          "$ref": "#/$defs/semver"
        },
        "version_header": {
          "const": "Teslatlas-Protocol-Version"
        },
        "selection": {
          "const": "highest-compatible-not-newer-than-client"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "introduced_in",
        "status",
        "href"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "maxLength": 96
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "introduced_in": {
          "$ref": "#/$defs/semver"
        },
        "status": {
          "enum": [
            "stable",
            "deprecated",
            "experimental"
          ]
        },
        "href": {
          "type": "string",
          "pattern": "^/[^?#]*$",
          "maxLength": 512
        },
        "deprecation": {
          "$ref": "#/$defs/deprecation"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/command_descriptor"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "deprecated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "deprecation"
            ]
          },
          "else": {
            "not": {
              "required": [
                "deprecation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "commands.async"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "commands"
            ]
          },
          "else": {
            "not": {
              "required": [
                "commands"
              ]
            }
          }
        }
      ]
    },
    "command_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command_class",
        "required_scope",
        "retry_policy",
        "confirmation_required",
        "parameters_schema",
        "expected_state_schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "command_class": {
          "enum": [
            "climate",
            "charging",
            "access",
            "nuisance",
            "vehicle_state"
          ]
        },
        "required_scope": {
          "type": "string",
          "pattern": "^vehicle\\.commands\\.(climate|charging|access|nuisance|vehicle_state)$"
        },
        "retry_policy": {
          "enum": [
            "none",
            "state_verified"
          ]
        },
        "confirmation_required": {
          "type": "boolean"
        },
        "parameters_schema": {
          "type": "object",
          "required": [
            "$schema",
            "type"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            }
          }
        },
        "expected_state_schema": {
          "type": "object",
          "required": [
            "$schema",
            "type"
          ],
          "properties": {
            "$schema": {
              "const": "https://json-schema.org/draft/2020-12/schema"
            },
            "type": {
              "const": "object"
            }
          }
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deprecated_at",
        "sunset_at",
        "successor",
        "documentation"
      ],
      "properties": {
        "deprecated_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "sunset_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "successor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "documentation": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "well_known",
        "api",
        "events",
        "openapi"
      ],
      "properties": {
        "well_known": {
          "type": "string",
          "format": "uri"
        },
        "api": {
          "type": "string",
          "format": "uri"
        },
        "events": {
          "type": "string",
          "format": "uri"
        },
        "openapi": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_request_body_bytes",
        "default_page_size",
        "max_page_size",
        "max_history_range_days",
        "max_dense_range_days",
        "max_concurrent_requests",
        "max_sse_connections",
        "event_replay_retention_seconds",
        "idempotency_retention_seconds"
      ],
      "properties": {
        "max_request_body_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "default_page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_page_size": {
          "type": "integer",
          "minimum": 100,
          "maximum": 500
        },
        "max_history_range_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "max_dense_range_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "max_concurrent_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_sse_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "event_replay_retention_seconds": {
          "type": "integer",
          "minimum": 86400,
          "maximum": 604800
        },
        "idempotency_retention_seconds": {
          "type": "integer",
          "minimum": 86400,
          "maximum": 604800
        }
      }
    }
  }
}
