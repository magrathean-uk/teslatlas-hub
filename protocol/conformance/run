#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

if command -v uv >/dev/null 2>&1; then
  exec uv run --project "$repo_dir" python "$script_dir/runner.py" "$@"
fi

exec "$repo_dir/.venv/bin/python" "$script_dir/runner.py" "$@"
