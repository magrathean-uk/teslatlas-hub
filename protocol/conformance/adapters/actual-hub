#!/bin/sh
set -eu
adapter_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH='' cd -- "$adapter_dir/../.." && pwd)
if command -v uv >/dev/null 2>&1; then
  exec uv run --project "$repo_dir" python "$adapter_dir/../hub_matrix.py" "$@"
fi
exec "$repo_dir/.venv/bin/python" "$adapter_dir/../hub_matrix.py" "$@"
