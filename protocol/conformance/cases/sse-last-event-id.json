{
  "capability": "events.sse",
  "case_id": "sse-last-event-id",
  "description": "Last-Event-ID resumes strictly after the named event and expired or invalid IDs are explicit.",
  "introduced_in": "1.0.0",
  "kind": "case",
  "steps": [
