      "request": {
        "headers": {
          "Last-Event-ID": "invalid event id",
          "Teslatlas-Protocol-Version": "${profile}"
        },
        "method": "GET",
        "path": "/v1/events",
        "query": {}
      },
      "step_id": "invalid"
    }
