{
  "protocol_version": "1.2.0",
  "endpoint": "/v1/events",
  "media_type": "text/event-stream",
  "encoding": "utf-8",
  "framing": {
    "fields": [
      "id",
      "event",
      "data",
      "retry"
    ],
    "dispatch_boundary": "blank-line",
    "data_lines": "concatenate-with-newline",
    "heartbeat_comment_seconds": 15
  },
  "replay": {
    "request_header": "Last-Event-ID",
    "resume": "strictly-after",
    "minimum_retention_seconds": 86400,
    "id_treatment": "opaque",
    "bound_to": [
      "hub_id",
      "principal",
      "normalized_filters"
    ],
    "reset": "empty-id-field",
    "invalid_status": 400,
    "invalid_error_code": "event_id_invalid",
    "expired_status": 410,
    "expired_error_code": "event_replay_expired"
  },
  "reconnect": {
    "default_retry_milliseconds": 3000,
    "maximum_retry_milliseconds": 30000,
    "terminal_status": 204
  },
  "events": [
    {
      "name": "observation.admitted",
      "introduced_in": "1.0.0",
      "data_schema": "urn:teslatlas:protocol:schema:event:1.2.0"
    },
