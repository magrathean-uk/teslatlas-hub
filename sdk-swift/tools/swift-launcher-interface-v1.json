{
  "schema_version": 1,
  "kind": "swift-installed-launcher-interface",
  "entrypoint": "run_installed(session_input_path, launcher)",
  "launcher_methods": [
    {
      "name": "remaining_cell_ms",
      "arguments": [
        "actor_id"
      ],
      "returns": "positive-integer-from-root-enclosing-monotonic-cell-deadline"
    },
    {
      "name": "run_worker",
      "arguments": [
        "actor_id",
        "worker_config_binding",
        "phase_callback"
      ],
      "returns": "swift-worker-outcome-v1"
    },
    {
      "name": "controller_observations",
      "arguments": [
        "session_id"
      ],
      "returns": "root-independent-controller-observation-map-v1"
    }
  ],
  "phase_callback": {
    "argument": "worker_ready_file_binding",
    "validates_exact_retained_bytes": true,
    "ready_keys": [
      "schema_version",
      "type",
      "session_id",
      "cell_id",
      "session_input_sha256",
      "instance_nonce",
      "sequence",
      "actor_id",
      "phase",
      "observation",
      "evidence"
    ],
    "returns": "worker_ack",
    "delivery": {
      "writer": "launcher",
      "path_template": "<worker_config.coordination_dir>/worker-ack-%06d.json",
      "encoding": "canonical-json-sorted-keys-compact-utf8-newline",
      "create": "exclusive",
      "mode": "0600",
      "durability": "file-fsync-before-worker-resume"
    },
    "ack_keys": [
      "schema_version",
      "type",
      "session_id",
      "cell_id",
      "session_input_sha256",
      "instance_nonce",
      "sequence",
      "ready_sha256",
      "actor_id",
      "phase",
      "status",
      "action",
      "result"
    ]
  },
  "outcome": {
    "keys": [
      "schema_version",
      "kind",
      "actor_id",
      "status",
      "framework_exit_code",
      "timed_out",
      "evidence",
      "log",
      "runtime",
      "cleanup"
    ],
    "cleanup_keys": [
      "process_exited",
      "stdout_closed",
      "stderr_closed"
    ]
  },
  "runtime_phase_admissions": {
    "owner": "launcher",
    "source": "retained-worker-ready-and-controller-observations",
    "ordered_phase_ids": [
      "bootstrap_pair",
      "revoke_and_pair",
      "restart",
      "outage_stop",
      "outage_start",
      "final_verify"
    ],
    "record_keys": [
      "ordinal",
      "phase_id",
      "session_sequence_before",
      "session_sequence_after",
      "ready_sha256"
    ],
    "worker_raw_is_authoritative": false
  },
  "worker_deadline": {
    "source": "launcher.remaining_cell_ms(actor_id)",
    "bound_config_key": "remaining_cell_ms",
    "clock": "worker-monotonic",
    "phase_cap": "sum-fixed-operation-deadlines-plus-10000ms-transfer"
  },
  "linux_worker_contract": {
    "path": "/Users/bolyki/dev/source/teslatlas-service/teslatlas-sdk-swift/tools/swift-linux-worker-contract-v1.json",
    "sha256": "d3f7a0ab940d18388694d89896fb1bf9974cacaa21d26faeda77a43a53bac764",
    "binding": "The fixed Linux Docker worker registration and relay contract is root-owned; this interface does not grant worker broker, Docker or command authority."
  },
  "reserved_worker_inputs": [
    {
      "id": "initial_observation",
      "schema": {
        "additional_properties": false,
        "keys": [
          "session_sequence",
          "proof_sha256"
        ]
      }
    }
  ],
  "schemas": [
    {
      "id": "matrix-worker-config-v1",
      "binding": {
        "path": "/Users/bolyki/dev/source/teslatlas-service/teslatlas-sdk-swift/tools/matrix-worker-config-v1.schema.json",
        "sha256": "cc761bbb4a0c38a4378dff119cfabdfbb1d288f2d626acd8e0a9c114c0bef582"
      }
    },
    {
      "id": "swift-worker-v1",
      "binding": {
        "path": "/Users/bolyki/dev/source/teslatlas-service/teslatlas-sdk-swift/tools/swift-worker-v1.schema.json",
        "sha256": "34a8176e28162f425353f4ba4d0f3dd1a00375a2c54b8829178aa754af2ac486"
      }
    },
    {
      "id": "swift-runtime-v1",
      "binding": {
        "path": "/Users/bolyki/dev/source/teslatlas-service/teslatlas-sdk-swift/tools/swift-runtime-v1.schema.json",
        "sha256": "d608f1e4c31548fbf7005e66a8997d5f0a65cee8685f60c096745ced278d24f2"
      }
    }
  ],
  "forbidden_worker_fields": [
    "argv",
    "broker",
    "command",
    "docker",
    "executable",
    "socket"
  ]
}
