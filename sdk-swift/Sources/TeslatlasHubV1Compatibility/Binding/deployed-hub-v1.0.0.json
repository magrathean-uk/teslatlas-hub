  "discovery": {
    "method": "GET",
    "path": "/.well-known/teslatlas-hub",
    "required_fields": [
      "hub_id",
      "protocol",
      "protocol_major",
      "api_versions",
      "capabilities",
      "version",
      "sourceUrl",
      "pack_format"
    ],
    "optional_fields": [
      "manifestPublicKey"
    ],
    "protocol": "teslatlas-sync",
    "protocol_major": 1,
    "api_versions": [
      "1.0"
    ],
    "hub_version": "1.0.0",
    "source_url": "https://github.com/magrathean-uk/teslatlas-hub/tree/v1.0.0",
    "pack_format": "sqlite-zstd",
    "allowed_capability_sets": [
      [
        "query.vehicles",
        "query.current"
      ],
      [
        "query.vehicles",
        "query.current",
        "query.drives",
        "sync.packs"
      ]
    ]
  },
  "authentication": {
    "header": "Authorization",
    "scheme": "Bearer",
    "bearer_wire_encoding": "ascii-hex",
    "bearer_wire_length": 64,
    "discovery_is_unauthenticated": true,
    "credentialed_operations": [
      "vehicles",
      "current_state",
      "drives"
    ],
    "allow_redirects": false,
    "non_loopback_requires_https": true
  },
  "responses": {
    "success_status": 200,
    "not_modified_status": 304,
    "bad_request_status": 400,
    "unauthorized_status": 401,
    "not_found_status": 404,
    "service_unavailable_status": 503,
    "json_media_type": "application/json",
    "content_type_header": "Content-Type",
    "request_id_header": "X-Request-ID",
    "entity_tag_header": "ETag",
    "unauthorized_challenge_header": "WWW-Authenticate",
    "unauthorized_challenge_value": "Bearer",
    "drive_error_status_by_code": {
      "invalid_query": 400,
      "invalid_time_range": 400,
      "invalid_limit": 400,
      "invalid_cursor": 400,
      "vehicle_not_found": 404,
      "service_unavailable": 503
    }
  },
  "routes": [
    {
      "operation": "vehicles",
      "method": "GET",
      "path_template": "/v1/vehicles",
      "required_capability": "query.vehicles",
      "response_model": "vehicle_list"
    },
    {
      "operation": "current_state",
      "method": "GET",
      "path_template": "/v1/vehicles/{vehicle_id}/current",
      "required_capability": "query.current",
      "response_model": "current_state"
    },
    {
      "operation": "drives",
      "method": "GET",
      "path_template": "/v1/vehicles/{vehicle_id}/drives",
      "required_capability": "query.drives",
      "response_model": "drive_page"
    }
  ],
  "drive_pagination": {
    "from_parameter": "from_ms",
    "from_default": 0,
    "from_minimum": 0,
    "from_inclusive": true,
    "to_parameter": "to_ms",
    "to_default": 9223372036854775807,
    "to_minimum": 0,
    "to_exclusive": true,
    "limit_parameter": "limit",
    "limit_default": 100,
    "limit_minimum": 1,
    "limit_maximum": 500,
    "cursor_parameter": "cursor",
    "cursor_is_opaque": true,
    "sort_fields": [
      "start_date_ms",
      "id"
    ],
    "sort_direction": "descending",
    "etag_is_strong": true,
    "conditional_request_header": "If-None-Match",
    "etag_format": "quoted-lowercase-sha256"
  },
  "models": {
    "vehicle_list": {
      "required_fields": [
        "vehicles"
      ],
      "optional_fields": []
    },
    "vehicle": {
