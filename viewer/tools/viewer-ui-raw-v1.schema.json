{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teslatlas:viewer:ui-raw-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "cell_id",
    "session_input_sha256",
    "actor_id",
    "operation",
    "session_sequence_before",
    "session_sequence_after",
    "facts",
    "requests"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "format": "uuid"},
    "cell_id": {"type": "string", "pattern": "^viewer__(macos_arm64|debian13_amd64|debian13_arm64)$"},
    "session_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor_id": {"const": "viewer_ui"},
    "operation": {"type": "string", "minLength": 1},
    "session_sequence_before": {"type": "integer", "minimum": 1},
    "session_sequence_after": {"type": "integer", "minimum": 1},
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hub_id": {"type": "string"},
        "profile_id": {"type": "string"},
        "profile_revision": {"type": "string"},
        "api_versions": {"type": "array", "items": {"type": "string"}},
        "protocol": {"type": "string"},
        "protocol_major": {"type": "integer"},
        "pack_format": {"type": "string"},
        "version": {"type": "string"},
        "discovery_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "authorization_headers": {"type": "integer", "minimum": 0},
        "credential_absent": {"type": "boolean"},
        "discovery": {"type": "integer", "minimum": 100, "maximum": 599},
        "health": {"type": "integer", "minimum": 100, "maximum": 599},
        "readiness": {"type": "integer", "minimum": 100, "maximum": 599},
        "claim_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "claimed": {"type": "integer", "minimum": 100, "maximum": 599},
        "typed_error": {"type": "string"},
        "credential_created": {"type": "boolean"},
        "fresh_claim_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "old_credential_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "cache_cleared": {"type": "boolean"},
        "reauth_completed": {"type": "boolean"},
        "pairing_required": {"type": "boolean"},
        "vehicles": {},
        "battery_level": {"type": "integer", "minimum": 0, "maximum": 100},
        "inside_temp": {"type": ["number", "null"]},
        "outside_temp": {"type": ["number", "null"]},
        "observed_at_ms": {"type": "integer", "minimum": 1},
        "est_battery_range_km": {"type": "number"},
        "odometer": {"type": "number"},
        "speed": {"type": "number"},
        "scheduled_charging_start_time": {"type": ["integer", "null"]},
        "active_route_miles_to_arrival": {"type": ["number", "null"]},
        "empty_vehicle_observed_at_ms": {"type": ["integer", "null"]},
        "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "state_of_charge": {"type": ["number", "null"]},
        "same_hub": {"type": "boolean"},
        "new_service_generation": {"type": "boolean"},
        "recovered": {"type": "boolean"},
        "unavailable_observed": {"type": "boolean"},
        "stale_notice": {"type": "boolean"},
        "unsupported_sections": {"type": "array", "items": {"type": "string"}},
        "outgoing_requests": {"type": "integer", "minimum": 0},
        "logout_requests": {"type": "integer", "minimum": 0},
        "pages": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "terminal_cursor": {"type": ["string", "null"]},
        "loaded_count": {"type": "integer", "minimum": 0},
        "conditional_requests": {"type": "integer", "minimum": 0},
        "conditional_statuses": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "rendered_exact_values": {"type": "boolean"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packed_sdk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preflight_succeeded": {"type": "boolean"},
        "cross_origin": {"type": "boolean"},
        "trusted_succeeded": {"type": "boolean"},
        "untrusted_error": {"type": "string"}
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "route", "status", "request_id"],
        "properties": {
          "method": {"type": "string", "enum": ["GET", "POST", "OPTIONS"]},
          "route": {"type": "string", "pattern": "^/"},
          "status": {"type": "integer", "minimum": 100, "maximum": 599},
          "request_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
