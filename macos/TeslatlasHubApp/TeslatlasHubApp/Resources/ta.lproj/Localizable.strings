"hub.TeslaMateServerImporter.840.2674" = "SSH-ஆல் இணைக்கவோ அங்கீகரிக்கவோ முடியவில்லை. சேவையகம், போர்ட், கணக்கு, தேர்ந்தெடுத்த அங்கீகார முறையைச் சரிபார்க்கவும்.";
"hub.TeslaMateServerImporter.842.2676" = "SSH அங்கீகாரம் தோல்வியடைந்தது. கணக்கு மற்றும் தேர்ந்தெடுத்த அங்கீகார முறையைச் சரிபார்க்கவும்.";
"hub.TeslaMateServerImporter.854.2688" = "SSH சேவையகம் இணைப்பை மூடியது. சேவையகப் பதிவுகள் மற்றும் SSH கொள்கையைச் சரிபார்க்கவும்.";
"hub.TeslaMateServerImporter.856.2690" = "SSH இணைப்பு நேரம் கடந்தது. சேவையக முகவரி, போர்ட், பிணையத்தைச் சரிபார்க்கவும்.";
"hub.TeslaMateServerImporter.858.2691" = "SSH வழியாக TeslaMate-ஐப் படிக்க முடியவில்லை. அங்கீகாரம் மற்றும் Docker அணுகலைச் சரிபார்க்கவும்.";
