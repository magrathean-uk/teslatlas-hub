"hub.SourceServerImporter.708.2548" = "கணக்கின் கடவுச்சொல்லைச் சரிபார்க்கவும் அல்லது SSH config, agent அல்லது விசைக்கு மாறவும்.";
"hub.SourceServerImporter.710.2550" = "சேவையக அடையாளத்தைச் சரிபார்க்க வேண்டும்";
