<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>uk.co.magrathean.teslatlas-edge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/teslatlas-edge/run-with-spool-format-guard.sh</string>
    <string>/usr/local/libexec/teslatlas-edge/teslatlas-edge</string>
    <string>/Users/Shared/TeslatlasEdge/spool</string>
    <string>--</string>
    <string>--config</string>
    <string>/Users/Shared/TeslatlasEdge/config.toml</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
