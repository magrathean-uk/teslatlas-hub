[Unit]
Description=Tesatlas Edge pinned Tesla Fleet Telemetry receiver
After=network-online.target tesatlas-edge.service
Wants=network-online.target
PartOf=tesatlas-edge.service
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/var/lib/tesatlas-edge/receiver-token
ConditionPathExists=/etc/tesatlas-edge/vehicle-tls.crt
ConditionPathExists=/etc/tesatlas-edge/vehicle-tls.key
ConditionPathExists=/etc/tesatlas-edge/vehicle-client-ca.crt

[Service]
Type=simple
User=tesatlas-edge
Group=tesatlas-edge
Environment=TESATLAS_FLEET_TELEMETRY_BEARER_FILE=/var/lib/tesatlas-edge/receiver-token
ExecStart=/usr/lib/tesatlas-edge/fleet-telemetry -config=/etc/tesatlas-edge/fleet-telemetry.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
InaccessiblePaths=/var/lib/tesatlas-edge/spool /var/lib/tesatlas-edge/spool-key /var/lib/tesatlas-edge/hub-credentials.json /etc/tesatlas-edge/hub-server.key
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
