#!/bin/sh
set -eu

service=teslatlas-edge.service
receiver_service=teslatlas-fleet-telemetry.service
state_file=${TESLATLAS_EDGE_MAINTAINER_STATE_FILE:-/run/teslatlas-edge-maintainer.state}
backup_dir=${TESLATLAS_EDGE_UPGRADE_BACKUP_DIR:-/run/teslatlas-edge-package-upgrade}
binary=/usr/bin/teslatlas-edge
receiver_binary=/usr/lib/teslatlas-edge/fleet-telemetry
guard=/usr/lib/teslatlas-edge/run-with-spool-format-guard.sh
unit=/lib/systemd/system/teslatlas-edge.service
receiver_unit=/lib/systemd/system/teslatlas-fleet-telemetry.service

ensure_account() {
    if ! getent group teslatlas-edge >/dev/null 2>&1; then
        addgroup --system teslatlas-edge
    fi
    if ! getent passwd teslatlas-edge >/dev/null 2>&1; then
        adduser --system --ingroup teslatlas-edge --home /var/lib/teslatlas-edge \
            --no-create-home --shell /usr/sbin/nologin teslatlas-edge
    fi
}

safe_backup() {
    source=$1
    destination=$2
    mode=$3
    [ -f "$source" ] && [ ! -L "$source" ] || {
        echo "existing Teslatlas Edge payload is missing or unsafe: $source" >&2
        exit 1
    }
    install -o root -g root -m "$mode" "$source" "$backup_dir/$destination"
}

service_state() {
    inspected=$1
    present=0
    active=0
    enabled=0
    if systemctl cat "$inspected" >/dev/null 2>&1; then
        present=1
        systemctl is-active --quiet "$inspected" && active=1
        systemctl is-enabled --quiet "$inspected" && enabled=1
    fi
    printf '%s %s %s\n' "$present" "$active" "$enabled"
}

stop_if_active() {
    inspected=$1
    if systemctl is-active --quiet "$inspected"; then
        systemctl stop "$inspected"
    fi
}

ensure_account
[ "${1:-}" = upgrade ] || exit 0

[ ! -e "$backup_dir" ] && [ ! -L "$backup_dir" ] || {
    echo "Teslatlas Edge upgrade backup already exists: $backup_dir" >&2
    exit 1
}
[ ! -e "$state_file" ] && [ ! -L "$state_file" ] || {
    echo "Teslatlas Edge maintainer state already exists: $state_file" >&2
    exit 1
}
[ -f "$binary" ] || exit 0
install -d -o root -g root -m 0700 "$backup_dir"
safe_backup "$binary" teslatlas-edge 0755
safe_backup "$receiver_binary" fleet-telemetry 0755
safe_backup "$guard" run-with-spool-format-guard.sh 0755
safe_backup "$unit" teslatlas-edge.service 0644
safe_backup "$receiver_unit" teslatlas-fleet-telemetry.service 0644

if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    edge_state=$(service_state "$service")
    receiver_state=$(service_state "$receiver_service")
    (umask 077 && printf '%s %s\n' "$edge_state" "$receiver_state" > "$state_file")
    stop_if_active "$receiver_service"
    stop_if_active "$service"
else
    rm -f "$backup_dir/teslatlas-edge.service" "$backup_dir/teslatlas-fleet-telemetry.service"
    rm -f "$backup_dir/teslatlas-edge" "$backup_dir/fleet-telemetry" \
        "$backup_dir/run-with-spool-format-guard.sh"
    find "$backup_dir" -depth -delete
fi
