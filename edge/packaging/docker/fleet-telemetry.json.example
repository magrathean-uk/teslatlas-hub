{
  "host": "0.0.0.0",
  "port": 8444,
  "status_port": 0,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesatlas-edge",
  "tesatlas": {
    "timeout_ms": 2000
  },
  "reliable_ack_sources": {
    "V": "tesatlas",
    "alerts": "tesatlas",
    "errors": "tesatlas"
  },
  "records": {
    "V": ["tesatlas"],
    "connectivity": ["tesatlas"],
    "alerts": ["tesatlas"],
    "errors": ["tesatlas"]
  },
  "tls": {
    "server_cert": "/run/tesatlas-edge-vehicle-tls/vehicle-tls.crt",
    "server_key": "/run/tesatlas-edge-vehicle-tls/vehicle-tls.key",
    "ca_file": "/run/tesatlas-edge-vehicle-tls/vehicle-client-ca.crt"
  }
}
