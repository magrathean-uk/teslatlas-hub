{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teslatlas.dev/schemas/edge-snapshot-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "session_id", "cell_id", "instance_nonce", "session_input_sha256", "actor_id", "invocation_id", "stage", "observation", "payload"],
  "properties": {
    "schema_version": {"const": 1}, "session_id": {"$ref": "#/$defs/uuid"}, "cell_id": {"type": "string", "pattern": "^edge_v2__(macos_arm64|debian13_amd64|debian13_arm64)$"}, "instance_nonce": {"$ref": "#/$defs/sha256"}, "session_input_sha256": {"$ref": "#/$defs/sha256"}, "actor_id": {"type": "string"}, "invocation_id": {"$ref": "#/$defs/token"}, "stage": {"$ref": "#/$defs/token"}, "observation": {"$ref": "#/$defs/observation"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["lane", "store_id", "store_schema_version", "selector_sha256", "current", "retained_observations", "lifecycle", "accumulator_jcs", "applications", "dispositions", "materialised_states", "open_rows", "sync_mutations", "counts"], "properties": {"lane": {"enum": ["primary", "reference", "fault", "negative"]}, "store_id": {"$ref": "#/$defs/uuid"}, "store_schema_version": {"const": 59}, "selector_sha256": {"$ref": "#/$defs/sha256"}, "current": {"type": "array", "maxItems": 256}, "retained_observations": {"type": "array", "maxItems": 256}, "lifecycle": {"type": ["object", "null"]}, "accumulator_jcs": {"type": "string", "maxLength": 1048576}, "applications": {"type": "array", "maxItems": 256}, "dispositions": {"type": "array", "maxItems": 256}, "materialised_states": {"type": "array", "maxItems": 256}, "open_rows": {"type": "array", "maxItems": 256}, "sync_mutations": {"type": "array", "maxItems": 256}, "counts": {"type": "object", "additionalProperties": false, "required": ["applications", "sequences", "pending_publications", "ack_frontier"], "properties": {"applications": {"type": "integer", "minimum": 0}, "sequences": {"type": "integer", "minimum": 0}, "pending_publications": {"type": "integer", "minimum": 0}, "ack_frontier": {"type": ["integer", "null"], "minimum": 0}}}}
    }
  },
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "observation": {"type": "object", "additionalProperties": false, "required": ["session_sequence", "proof_sha256"], "properties": {"session_sequence": {"type": "integer", "minimum": 1}, "proof_sha256": {"$ref": "#/$defs/sha256"}}}}
}
