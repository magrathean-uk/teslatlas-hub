{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teslatlas.dev/schemas/edge-http-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "session_id", "cell_id", "instance_nonce", "session_input_sha256", "actor_id", "invocation_id", "stage", "observation", "payload"],
  "properties": {
    "schema_version": {"const": 1}, "session_id": {"$ref": "#/$defs/uuid"}, "cell_id": {"type": "string", "pattern": "^edge_v2__(macos_arm64|debian13_amd64|debian13_arm64)$"}, "instance_nonce": {"$ref": "#/$defs/sha256"}, "session_input_sha256": {"$ref": "#/$defs/sha256"}, "actor_id": {"type": "string"}, "invocation_id": {"$ref": "#/$defs/token"}, "stage": {"$ref": "#/$defs/token"}, "observation": {"$ref": "#/$defs/observation"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["role", "transcript", "tls", "transport_failures", "census"], "properties": {
      "role": {"enum": ["hub_public", "edge_delivery", "negative_responder"]}, "transcript": {"type": "array", "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["request_id", "method", "route", "status", "request_body_sha256", "response_body"], "properties": {"request_id": {"$ref": "#/$defs/token"}, "method": {"enum": ["GET", "POST"]}, "route": {"type": "string", "pattern": "^/"}, "status": {"type": "integer", "minimum": 100, "maximum": 599}, "request_body_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "response_body": {"$ref": "#/$defs/binding"}}}}, "tls": {"type": "object", "additionalProperties": false, "required": ["server_der_sha256", "client_der_sha256", "chain_verified", "hostname_verified"], "properties": {"server_der_sha256": {"$ref": "#/$defs/sha256"}, "client_der_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "chain_verified": {"type": "boolean"}, "hostname_verified": {"type": "boolean"}}}, "transport_failures": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["request_id", "phase", "outcome"], "properties": {"request_id": {"$ref": "#/$defs/token"}, "phase": {"enum": ["handshake", "connect", "body"]}, "outcome": {"enum": ["rejected", "aborted"]}}}}, "census": {"type": "object", "additionalProperties": false, "required": ["v2_gets", "v2_acks", "v1_requests", "redirect_requests"], "properties": {"v2_gets": {"type": "integer", "minimum": 0}, "v2_acks": {"type": "integer", "minimum": 0}, "v1_requests": {"type": "integer", "minimum": 0}, "redirect_requests": {"type": "integer", "minimum": 0}}}
    }}
  },
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^/[^\\u0000\\r\\n]*$"}, "sha256": {"$ref": "#/$defs/sha256"}}}, "observation": {"type": "object", "additionalProperties": false, "required": ["session_sequence", "proof_sha256"], "properties": {"session_sequence": {"type": "integer", "minimum": 1}, "proof_sha256": {"$ref": "#/$defs/sha256"}}}}
}
