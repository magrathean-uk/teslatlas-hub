#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH='' cd "$(dirname "$0")" && pwd)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=common.sh
. "$SCRIPT_DIR/common.sh"

require_root
read_console_user
refuse_other_user_launch_agents

# BEGIN TESTABLE GUI UPDATE HELPER
stop_running_app_for_update() {
    process_name=$1
    expected_uid=$2
    if ! /usr/bin/pgrep -u "$expected_uid" -x "$process_name" >/dev/null 2>&1; then
        return 0
    fi
    /usr/bin/pkill -TERM -u "$expected_uid" -x "$process_name" >/dev/null 2>&1 || true
    attempt=1
    while [ "$attempt" -le 50 ]; do
        /usr/bin/pgrep -u "$expected_uid" -x "$process_name" >/dev/null 2>&1 || return 0
        /bin/sleep 0.1
        attempt=$((attempt + 1))
    done
    /usr/bin/pkill -KILL -u "$expected_uid" -x "$process_name" >/dev/null 2>&1 || true
    attempt=1
    while [ "$attempt" -le 20 ]; do
        /usr/bin/pgrep -u "$expected_uid" -x "$process_name" >/dev/null 2>&1 || return 0
        /bin/sleep 0.1
        attempt=$((attempt + 1))
    done
    return 1
}
# END TESTABLE GUI UPDATE HELPER

stop_running_app_for_update 'Teslatlas Hub' "$CONSOLE_UID" \
    || installer_error "cannot stop the running Teslatlas Hub app for update"

STATE_DIRECTORY=$(upgrade_state_directory)
remove_upgrade_state "$STATE_DIRECTORY"
/usr/bin/install -d -o root -g wheel -m 0700 "$STATE_DIRECTORY" \
    || installer_error "cannot create upgrade state"

if [ -e "$BINARY_ROOT" ] || [ -L "$BINARY_ROOT" ]; then
    require_safe_owned_tree "$BINARY_ROOT" 0 "existing Hub service payload"
fi

PLIST="$CONSOLE_HOME/Library/LaunchAgents/$LABEL.plist"
if service_is_loaded; then
    require_safe_regular_file "$PLIST" "$CONSOLE_UID" "existing LaunchAgent"
    /usr/bin/install -o root -g wheel -m 0600 /dev/null "$STATE_DIRECTORY/was-loaded" \
        || installer_error "cannot record loaded service state"
fi

if [ -e "$BINARY" ] || [ -L "$BINARY" ]; then
    require_safe_regular_file "$BINARY" 0 "existing Hub binary"
    [ -x "$BINARY" ] || installer_error "existing Hub binary is not executable"
    /usr/bin/install -o root -g wheel -m 0755 "$BINARY" "$STATE_DIRECTORY/teslatlas-hub" \
        || installer_error "cannot preserve existing Hub binary"
fi

if [ -e "$PLIST" ] || [ -L "$PLIST" ]; then
    require_safe_regular_file "$PLIST" "$CONSOLE_UID" "existing LaunchAgent"
    /usr/bin/install -o root -g wheel -m 0600 "$PLIST" "$STATE_DIRECTORY/launch-agent.plist" \
        || installer_error "cannot preserve existing LaunchAgent"
fi
