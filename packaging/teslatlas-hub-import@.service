[Unit]
Description=Teslatlas Hub read-only TeslaMate import for car %i
Wants=network-online.target
After=network-online.target teslatlas-hub.service

[Service]
Type=oneshot
User=teslatlas
Group=teslatlas
UMask=0077
WorkingDirectory=/var/lib/teslatlas
StateDirectory=teslatlas
StateDirectoryMode=0750
RuntimeDirectory=teslatlas
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/teslatlas-hub --config /etc/teslatlas/config.toml import-teslamate --car-id %i
TimeoutStartSec=30min
TimeoutStopSec=30s
LimitNOFILE=65536
TasksMax=512

# The cursor key and the TeslaMate PostgreSQL password are only injected by
# systemd credential drop-ins. This service is manual; it has no timer and
# never writes to the TeslaMate source database.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @swap @reboot @obsolete @privileged
ProcSubset=pid
