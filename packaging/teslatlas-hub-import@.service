[Unit]
Description=Teslatlas Hub read-only TeslaMate import for car %i
Wants=network-online.target
After=network-online.target teslatlas-hub.service
Before=teslatlas-hub-collect.service teslatlas-hub-supervised.service

[Service]
Type=oneshot
User=teslatlas
Group=teslatlas
UMask=0077
WorkingDirectory=/var/lib/teslatlas
StateDirectory=teslatlas
StateDirectoryMode=0700
RuntimeDirectory=teslatlas
RuntimeDirectoryMode=0700
# The exclusive gate covers the active-state check and the complete import.
# Every collector ExecStart takes the shared side of this same gate.
# Before= keeps direct systemd collector starts ordered behind an import.
ExecStart=/usr/bin/flock --exclusive --nonblock /run/teslatlas/import-collector.lock /bin/sh -ec 'for unit in teslatlas-hub-collect.service teslatlas-hub-supervised.service; do state=$$(/usr/bin/systemctl show --property=ActiveState --value "$$unit") || exit 1; case "$$state" in inactive|failed) ;; *) exit 1 ;; esac; done; exec /usr/bin/teslatlas-hub --config /etc/teslatlas/config.toml import-tesla-mate --car-id %i'
TimeoutStartSec=12h
TimeoutStopSec=30s
LimitNOFILE=65536
TasksMax=512

# The cursor key and the TeslaMate PostgreSQL password are only injected by
# systemd credential drop-ins. This service is manual; it has no timer and
# never writes to the TeslaMate source database.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=~@mount @swap @reboot @obsolete @privileged
ProcSubset=pid
