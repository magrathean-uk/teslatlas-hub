diff --git a/config/optional_dispatchers_cgo.go b/config/optional_dispatchers_cgo.go
new file mode 100644
index 0000000..87e401d
--- /dev/null
+++ b/config/optional_dispatchers_cgo.go
@@ -0,0 +1,36 @@
+//go:build cgo
+
+package config
+
+import (
+	"context"
+
+	confluent "github.com/confluentinc/confluent-kafka-go/v2/kafka"
+
+	"github.com/teslamotors/fleet-telemetry/datastore/kafka"
+	"github.com/teslamotors/fleet-telemetry/datastore/zmq"
+	logrus "github.com/teslamotors/fleet-telemetry/logger"
+	"github.com/teslamotors/fleet-telemetry/server/airbrake"
+	"github.com/teslamotors/fleet-telemetry/telemetry"
+)
+
+type KafkaConfig = confluent.ConfigMap
+type ZMQConfig = zmq.Config
+
+func (c *Config) newKafkaProducer(airbrakeHandler *airbrake.Handler, reliableAckSources map[telemetry.Dispatcher]map[string]interface{}, logger *logrus.Logger) (telemetry.Producer, error) {
+	convertKafkaConfig(c.Kafka)
+	return kafka.NewProducer(c.Kafka, c.Namespace, c.prometheusEnabled(), c.MetricCollector, airbrakeHandler, c.AckChan, reliableAckSources[telemetry.Kafka], logger)
+}
+
+func (c *Config) newZMQProducer(airbrakeHandler *airbrake.Handler, reliableAckSources map[telemetry.Dispatcher]map[string]interface{}, logger *logrus.Logger) (telemetry.Producer, error) {
+	return zmq.NewProducer(context.Background(), c.ZMQ, c.MetricCollector, c.Namespace, airbrakeHandler, c.AckChan, reliableAckSources[telemetry.ZMQ], logger)
+}
+
+// convertKafkaConfig will prioritize int over float.
+func convertKafkaConfig(input *KafkaConfig) {
+	for key, val := range *input {
+		if i, ok := val.(float64); ok {
+			(*input)[key] = int(i)
+		}
+	}
+}
