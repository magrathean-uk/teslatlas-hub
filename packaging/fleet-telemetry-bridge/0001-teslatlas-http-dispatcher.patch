+package teslatlas
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/timestamppb"
+
+	logrus "github.com/teslamotors/fleet-telemetry/logger"
+	"github.com/teslamotors/fleet-telemetry/messages"
+	"github.com/teslamotors/fleet-telemetry/protos"
+	"github.com/teslamotors/fleet-telemetry/server/airbrake"
+	"github.com/teslamotors/fleet-telemetry/telemetry"
+)
+
+func TestProducePostsOneEnvelopeThenAcknowledges(t *testing.T) {
+	received := make(chan Envelope, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(response http.ResponseWriter, request *http.Request) {
+		if request.Method != http.MethodPost {
+			t.Errorf("method = %s", request.Method)
+		}
+		if request.Header.Get("Authorization") != "Bearer bridge-secret" {
+			t.Errorf("authorization was not the bridge bearer")
+		}
+		if request.Header.Get("Content-Type") != "application/json" {
+			t.Errorf("content type = %s", request.Header.Get("Content-Type"))
+		}
+		body, err := io.ReadAll(request.Body)
+		if err != nil {
+			t.Errorf("read envelope: %v", err)
+			response.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		if strings.Contains(string(body), "device_client_version") {
+			t.Error("envelope contains an unsupported field")
+		}
+		var envelope Envelope
+		if err := json.Unmarshal(body, &envelope); err != nil {
+			t.Errorf("decode envelope: %v", err)
+			response.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		received <- envelope
+		response.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	acks := make(chan *telemetry.Record, 1)
+	producer := testProducer(t, server.URL, acks)
+	record := testRecord(t, "Athena")
+	producer.Produce(record)
+
+	select {
+	case ack := <-acks:
+		if ack != record {
+			t.Fatal("acknowledged a different record")
+		}
+	default:
+		t.Fatal("successful delivery was not acknowledged")
+	}
+	envelope := <-received
+	if envelope.Version != EnvelopeVersion || envelope.VIN != "TEST123" || envelope.TXID != "tx-1" || envelope.TXType != "V" {
+		t.Fatalf("unexpected envelope identity: %+v", envelope)
+	}
+	if envelope.TimestampMS != 1700000000123 || envelope.ReceivedAtMS != record.ReceivedTimestamp {
+		t.Fatalf("unexpected envelope timestamps: %+v", envelope)
+	}
+	var payload map[string]interface{}
+	if err := json.Unmarshal(envelope.Payload, &payload); err != nil {
+		t.Fatalf("decode payload: %v", err)
+	}
+	data, ok := payload["data"].([]interface{})
+	if !ok || len(data) != 1 {
+		t.Fatalf("unexpected decoded payload: %#v", payload)
+	}
+	datum, ok := data[0].(map[string]interface{})
+	value, valueOK := datum["value"].(map[string]interface{})
+	if !ok || !valueOK || datum["key"] != "VehicleName" || value["stringValue"] != "Athena" || payload["vin"] != "TEST123" {
+		t.Fatalf("unexpected decoded payload: %#v", payload)
+	}
+}
