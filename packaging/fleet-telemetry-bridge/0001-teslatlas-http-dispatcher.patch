+func TestBearerLoadsOnlyFromPrivateOwnedRegularFile(t *testing.T) {
+	file := t.TempDir() + "/bearer"
+	if err := os.WriteFile(file, []byte("bridge-secret\n"), 0o600); err != nil {
+		t.Fatalf("write bearer: %v", err)
+	}
+	t.Setenv(BearerFileEnv, file)
+	bearer, err := loadBearerFile()
+	if err != nil || bearer != "bridge-secret" {
+		t.Fatalf("load bearer = %q, %v", bearer, err)
+	}
+	if err := os.Chmod(file, 0o644); err != nil {
+		t.Fatalf("loosen bearer mode: %v", err)
+	}
+	if _, err := loadBearerFile(); err == nil {
+		t.Fatal("world-readable bearer was accepted")
+	}
+}
+
+func TestBearerFileRejectsSymlink(t *testing.T) {
+	directory := t.TempDir()
+	file := directory + "/bearer"
+	link := directory + "/bearer-link"
+	if err := os.WriteFile(file, []byte("bridge-secret"), 0o600); err != nil {
+		t.Fatalf("write bearer: %v", err)
+	}
+	if err := os.Symlink(file, link); err != nil {
+		t.Fatalf("link bearer: %v", err)
+	}
+	t.Setenv(BearerFileEnv, link)
+	if _, err := loadBearerFile(); err == nil {
+		t.Fatal("symlink bearer was accepted")
+	}
+}
