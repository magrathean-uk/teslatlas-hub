+func TestNonSuccessAndRedirectNeverAcknowledge(t *testing.T) {
+	var redirected atomic.Int32
+	target := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
+		redirected.Add(1)
+	}))
+	defer target.Close()
+
+	for name, handler := range map[string]http.HandlerFunc{
+		"non-success": func(response http.ResponseWriter, _ *http.Request) {
+			response.WriteHeader(http.StatusServiceUnavailable)
+		},
+		"redirect": func(response http.ResponseWriter, request *http.Request) {
+			http.Redirect(response, request, target.URL, http.StatusTemporaryRedirect)
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			server := httptest.NewServer(handler)
+			defer server.Close()
+			acks := make(chan *telemetry.Record, 1)
+			producer := testProducer(t, server.URL, acks)
+			producer.Produce(testRecord(t, "Athena"))
+			select {
+			case <-acks:
+				t.Fatal("failed delivery was acknowledged")
+			default:
+			}
+		})
+	}
+	if redirected.Load() != 0 {
+		t.Fatal("bridge followed a redirect")
+	}
+}
+
+func TestOversizeEnvelopeNeverPostsOrAcknowledges(t *testing.T) {
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(response http.ResponseWriter, _ *http.Request) {
+		requests.Add(1)
+		response.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	acks := make(chan *telemetry.Record, 1)
+	producer := testProducer(t, server.URL, acks)
+	producer.Produce(testRecord(t, strings.Repeat("\x00", 700000)))
+	if requests.Load() != 0 {
+		t.Fatal("oversize envelope reached HTTP endpoint")
+	}
+	select {
+	case <-acks:
+		t.Fatal("oversize envelope was acknowledged")
+	default:
+	}
+}
