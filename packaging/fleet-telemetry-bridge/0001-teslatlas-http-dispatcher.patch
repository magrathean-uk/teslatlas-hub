new file mode 100644
index 0000000..d286799
--- /dev/null
+++ b/datastore/teslatlas/teslatlas.go
@@ -0,0 +1,288 @@
+package teslatlas
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"time"
+
+	logrus "github.com/teslamotors/fleet-telemetry/logger"
+	"github.com/teslamotors/fleet-telemetry/protos"
+	"github.com/teslamotors/fleet-telemetry/server/airbrake"
+	"github.com/teslamotors/fleet-telemetry/telemetry"
+	"golang.org/x/sys/unix"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+const (
+	Endpoint            = "http://127.0.0.1:8080/v1/internal/fleet-telemetry"
+	BearerFileEnv       = "TESLATLAS_FLEET_TELEMETRY_BEARER_FILE"
+	EnvelopeVersion     = 1
+	MaxEnvelopeBytes    = 256 * 1024
+	MaxBearerBytes      = 4096
+	DefaultTimeoutMS    = 2000
+	MinimumTimeoutMS    = 100
+	MaximumTimeoutMS    = 5000
+	maximumResponseBody = 1024
+)
+
+type Config struct {
+	TimeoutMS int `json:"timeout_ms,omitempty"`
+}
+
+type Envelope struct {
+	Version      int             `json:"version"`
+	VIN          string          `json:"vin"`
+	TXID         string          `json:"txid"`
+	TXType       string          `json:"tx_type"`
+	ReceivedAtMS int64           `json:"received_at_ms"`
+	TimestampMS  int64           `json:"timestamp_ms"`
+	Payload      json.RawMessage `json:"payload"`
+}
+
+type Producer struct {
+	ctx                context.Context
+	endpoint           string
+	bearer             string
+	client             *http.Client
+	transport          *http.Transport
+	logger             *logrus.Logger
+	airbrakeHandler    *airbrake.Handler
+	ackChan            chan *telemetry.Record
+	reliableAckTxTypes map[string]interface{}
+}
+
+func NewProducer(ctx context.Context, config *Config, airbrakeHandler *airbrake.Handler, ackChan chan *telemetry.Record, reliableAckTxTypes map[string]interface{}, logger *logrus.Logger) (telemetry.Producer, error) {
+	if config == nil {
+		return nil, errors.New("teslatlas config is required")
+	}
+	bearer, err := loadBearerFile()
+	if err != nil {
+		return nil, err
+	}
+	return newProducer(ctx, config, Endpoint, bearer, airbrakeHandler, ackChan, reliableAckTxTypes, logger)
+}
+
+func newProducer(ctx context.Context, config *Config, endpoint string, bearer string, airbrakeHandler *airbrake.Handler, ackChan chan *telemetry.Record, reliableAckTxTypes map[string]interface{}, logger *logrus.Logger) (*Producer, error) {
+	if err := validateEndpoint(endpoint); err != nil {
+		return nil, err
+	}
+	if err := validateBearer(bearer); err != nil {
+		return nil, err
+	}
+	timeout, err := requestTimeout(config.TimeoutMS)
+	if err != nil {
+		return nil, err
+	}
+	dialTimeout := timeout
+	if dialTimeout > 500*time.Millisecond {
+		dialTimeout = 500 * time.Millisecond
+	}
+	transport := &http.Transport{
+		Proxy:                 nil,
+		DialContext:           (&net.Dialer{Timeout: dialTimeout, KeepAlive: 30 * time.Second}).DialContext,
+		DisableCompression:    true,
+		ForceAttemptHTTP2:     false,
+		MaxIdleConns:          1,
+		MaxIdleConnsPerHost:   1,
+		IdleConnTimeout:       30 * time.Second,
+		ResponseHeaderTimeout: timeout,
+	}
+	client := &http.Client{
+		Transport: transport,
+		Timeout:   timeout,
+		CheckRedirect: func(_ *http.Request, _ []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	return &Producer{
+		ctx:                ctx,
+		endpoint:           endpoint,
+		bearer:             bearer,
+		client:             client,
+		transport:          transport,
+		logger:             logger,
+		airbrakeHandler:    airbrakeHandler,
+		ackChan:            ackChan,
+		reliableAckTxTypes: reliableAckTxTypes,
+	}, nil
+}
+
+func requestTimeout(timeoutMS int) (time.Duration, error) {
+	if timeoutMS == 0 {
+		timeoutMS = DefaultTimeoutMS
+	}
+	if timeoutMS < MinimumTimeoutMS || timeoutMS > MaximumTimeoutMS {
+		return 0, fmt.Errorf("teslatlas timeout_ms must be between %d and %d", MinimumTimeoutMS, MaximumTimeoutMS)
+	}
+	return time.Duration(timeoutMS) * time.Millisecond, nil
+}
+
+func validateEndpoint(endpoint string) error {
+	parsed, err := url.Parse(endpoint)
+	if err != nil || parsed.Scheme != "http" || parsed.User != nil || parsed.RawQuery != "" || parsed.Fragment != "" {
+		return errors.New("teslatlas endpoint must be a fixed loopback HTTP URL")
+	}
+	address := net.ParseIP(parsed.Hostname())
+	if address == nil || !address.IsLoopback() || parsed.Port() == "" {
+		return errors.New("teslatlas endpoint must be a fixed loopback HTTP URL")
+	}
+	return nil
+}
+
+func validateBearer(bearer string) error {
+	if len(bearer) == 0 || len(bearer) > MaxBearerBytes {
+		return errors.New("teslatlas bearer is missing or invalid")
+	}
+	for index := 0; index < len(bearer); index++ {
+		if bearer[index] < 0x21 || bearer[index] > 0x7e {
+			return errors.New("teslatlas bearer is missing or invalid")
+		}
+	}
+	return nil
+}
+
+func loadBearerFile() (string, error) {
+	path := os.Getenv(BearerFileEnv)
+	if path == "" || !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return "", errors.New("teslatlas bearer file path is missing or invalid")
+	}
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return "", errors.New("cannot securely open teslatlas bearer file")
+	}
+	file := os.NewFile(uintptr(fd), path)
+	if file == nil {
+		_ = unix.Close(fd)
+		return "", errors.New("cannot securely open teslatlas bearer file")
+	}
+	defer file.Close()
+	var stat unix.Stat_t
+	if err := unix.Fstat(fd, &stat); err != nil {
+		return "", errors.New("cannot inspect teslatlas bearer file")
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFREG || stat.Uid != uint32(os.Geteuid()) || stat.Mode&0o077 != 0 {
+		return "", errors.New("teslatlas bearer file must be a private regular file owned by the service user")
+	}
+	if stat.Size < 1 || stat.Size > MaxBearerBytes+2 {
+		return "", errors.New("teslatlas bearer file size is invalid")
+	}
+	contents, err := io.ReadAll(io.LimitReader(file, MaxBearerBytes+3))
+	if err != nil || len(contents) > MaxBearerBytes+2 {
+		return "", errors.New("cannot read teslatlas bearer file")
+	}
+	if bytes.HasSuffix(contents, []byte("\r\n")) {
+		contents = contents[:len(contents)-2]
+	} else if bytes.HasSuffix(contents, []byte("\n")) {
+		contents = contents[:len(contents)-1]
+	}
+	bearer := string(contents)
+	if err := validateBearer(bearer); err != nil {
+		return "", err
+	}
+	return bearer, nil
+}
+
+func (p *Producer) Produce(record *telemetry.Record) {
+	if p.ctx.Err() != nil {
+		return
+	}
+	body, err := marshalEnvelope(record)
+	if err == nil {
+		err = p.post(body)
+	}
+	if err != nil {
+		p.ReportError("teslatlas_dispatch_error", err, logrus.LogInfo{
+			"tx_type": record.TxType,
+		})
+		return
+	}
+	p.ProcessReliableAck(record)
+}
+
+func marshalEnvelope(record *telemetry.Record) ([]byte, error) {
+	payload, err := record.GetJSONPayload()
+	if err != nil {
+		return nil, fmt.Errorf("decode payload: %w", err)
+	}
+	if !json.Valid(payload) {
+		return nil, errors.New("decoded payload is not valid JSON")
+	}
+	body, err := json.Marshal(Envelope{
+		Version:      EnvelopeVersion,
+		VIN:          record.Vin,
+		TXID:         record.Txid,
+		TXType:       record.TxType,
+		ReceivedAtMS: record.ReceivedTimestamp,
+		TimestampMS:  payloadTimestampMS(record),
+		Payload:      json.RawMessage(payload),
+	})
+	if err != nil {
+		return nil, fmt.Errorf("encode envelope: %w", err)
+	}
+	if len(body) > MaxEnvelopeBytes {
+		return nil, fmt.Errorf("teslatlas envelope exceeds %d bytes", MaxEnvelopeBytes)
+	}
+	return body, nil
+}
+
+func payloadTimestampMS(record *telemetry.Record) int64 {
+	var timestamp *timestamppb.Timestamp
+	switch payload := record.GetProtoMessage().(type) {
+	case *protos.Payload:
+		timestamp = payload.GetCreatedAt()
+	case *protos.VehicleAlerts:
+		timestamp = payload.GetCreatedAt()
+	case *protos.VehicleErrors:
+		timestamp = payload.GetCreatedAt()
+	case *protos.VehicleConnectivity:
+		timestamp = payload.GetCreatedAt()
+	}
+	if timestamp == nil || timestamp.CheckValid() != nil {
+		return 0
+	}
+	return timestamp.AsTime().UnixMilli()
+}
+
+func (p *Producer) post(body []byte) error {
+	request, err := http.NewRequestWithContext(p.ctx, http.MethodPost, p.endpoint, bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	request.Header.Set("Authorization", "Bearer "+p.bearer)
+	request.Header.Set("Content-Type", "application/json")
+	response, err := p.client.Do(request)
+	if err != nil {
+		return err
+	}
+	_, _ = io.Copy(io.Discard, io.LimitReader(response.Body, maximumResponseBody))
+	closeErr := response.Body.Close()
+	if response.StatusCode < http.StatusOK || response.StatusCode >= http.StatusMultipleChoices {
+		return fmt.Errorf("teslatlas endpoint returned HTTP %d", response.StatusCode)
+	}
+	return closeErr
+}
+
+func (p *Producer) ProcessReliableAck(record *telemetry.Record) {
+	if _, ok := p.reliableAckTxTypes[record.TxType]; ok {
+		p.ackChan <- record
+	}
+}
+
+func (p *Producer) ReportError(message string, err error, logInfo logrus.LogInfo) {
+	p.airbrakeHandler.ReportLogMessage(logrus.ERROR, message, err, logInfo)
+	p.logger.ErrorLog(message, err, logInfo)
+}
+
+func (p *Producer) Close() error {
+	p.transport.CloseIdleConnections()
+	return nil
+}
