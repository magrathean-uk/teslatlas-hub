+func testRecord(t *testing.T, vehicleName string) *telemetry.Record {
+	t.Helper()
+	createdAt := timestamppb.New(time.UnixMilli(1700000000123))
+	payloadBytes, err := proto.Marshal(&protos.Payload{
+		CreatedAt: createdAt,
+		Vin:       "TEST123",
+		Data: []*protos.Datum{{
+			Key: protos.Field_VehicleName,
+			Value: &protos.Value{Value: &protos.Value_StringValue{
+				StringValue: vehicleName,
+			}},
+		}},
+	})
+	if err != nil {
+		t.Fatalf("marshal payload: %v", err)
+	}
+	wireBytes, err := (&messages.StreamMessage{
+		TXID:         []byte("tx-1"),
+		SenderID:     []byte("vehicle_device.TEST123"),
+		MessageTopic: []byte("V"),
+		Payload:      payloadBytes,
+	}).ToBytes()
+	if err != nil {
+		t.Fatalf("marshal stream message: %v", err)
+	}
+	logger, _ := logrus.NoOpLogger()
+	serializer := telemetry.NewBinarySerializer(&telemetry.RequestIdentity{
+		DeviceID:            "TEST123",
+		SenderID:            "vehicle_device.TEST123",
+		DeviceClientVersion: "1.2.3",
+	}, map[string][]telemetry.Producer{"V": nil}, logger)
+	record, err := telemetry.NewRecord(serializer, wireBytes, "socket-1", true)
+	if err != nil {
+		t.Fatalf("new record: %v", err)
+	}
+	return record
+}
