+func testProducer(t *testing.T, endpoint string, acks chan *telemetry.Record) *Producer {
+	t.Helper()
+	logger, _ := logrus.NoOpLogger()
+	producer, err := newProducer(
+		context.Background(),
+		&Config{TimeoutMS: 500},
+		endpoint,
+		"bridge-secret",
+		airbrake.NewAirbrakeHandler(nil),
+		acks,
+		map[string]interface{}{"V": true},
