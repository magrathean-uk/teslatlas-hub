#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu

service=teslatlas-hub.service
command_proxy_service=teslatlas-command-proxy.service
fleet_telemetry_service=teslatlas-fleet-telemetry.service
state_file=${TESLATLAS_HUB_MAINTAINER_STATE_FILE:-/run/teslatlas-hub-maintainer.state}
backup_dir=${TESLATLAS_HUB_UPGRADE_BACKUP_DIR:-/run/teslatlas-hub-package-upgrade}
health_attempts=${TESLATLAS_HUB_HEALTH_ATTEMPTS:-10}
health_delay=${TESLATLAS_HUB_HEALTH_DELAY_SECONDS:-1}
health_timeout=${TESLATLAS_HUB_HEALTH_TIMEOUT_SECONDS:-5}
preflight_timeout=${TESLATLAS_HUB_PREFLIGHT_TIMEOUT_SECONDS:-120}
bootstrap_timeout=${TESLATLAS_HUB_BOOTSTRAP_TIMEOUT_SECONDS:-300}
hub_binary=${TESLATLAS_HUB_BINARY:-/usr/bin/teslatlas-hub}
unit_file=${TESLATLAS_HUB_UNIT_FILE:-/lib/systemd/system/teslatlas-hub.service}
terminal_failure_target_file=${TESLATLAS_HUB_TERMINAL_FAILURE_TARGET_FILE:-/lib/systemd/system/teslatlas-hub-terminal-failure.target}
command_proxy_binary=${TESLATLAS_COMMAND_PROXY_BINARY:-/usr/lib/teslatlas-hub/tesla-http-proxy}
fleet_telemetry_binary=${TESLATLAS_FLEET_TELEMETRY_BINARY:-/usr/lib/teslatlas-hub/fleet-telemetry}
command_proxy_unit_file=${TESLATLAS_COMMAND_PROXY_UNIT_FILE:-/lib/systemd/system/teslatlas-command-proxy.service}
fleet_telemetry_unit_file=${TESLATLAS_FLEET_TELEMETRY_UNIT_FILE:-/lib/systemd/system/teslatlas-fleet-telemetry.service}
command_proxy_config=${TESLATLAS_COMMAND_PROXY_CONFIG:-/etc/teslatlas-hub/command-proxy.env}
fleet_telemetry_config=${TESLATLAS_FLEET_TELEMETRY_CONFIG:-/etc/teslatlas-hub/fleet-telemetry.json}
config_file=${TESLATLAS_HUB_CONFIG:-/etc/teslatlas-hub/config.toml}
runuser_binary=${TESLATLAS_HUB_RUNUSER:-/usr/sbin/runuser}
timeout_binary=${TESLATLAS_HUB_TIMEOUT:-/usr/bin/timeout}
forward_only=0

unit_available() {
    systemctl cat "$1" >/dev/null 2>&1
}

read_service_state() {
    [ -f "$state_file" ] && [ ! -L "$state_file" ] || return 1
    IFS= read -r state_line < "$state_file" || return 1
    set -f
    set -- $state_line
    set +f
    case "$#" in
        2)
            hub_present=1
            hub_active=$1
            hub_enabled=$2
            proxy_present=0
            proxy_active=0
            proxy_enabled=0
            telemetry_present=0
            telemetry_active=0
            telemetry_enabled=0
            ;;
        9)
            hub_present=$1
            hub_active=$2
            hub_enabled=$3
            proxy_present=$4
            proxy_active=$5
            proxy_enabled=$6
            telemetry_present=$7
            telemetry_active=$8
            telemetry_enabled=$9
            ;;
        *) return 1 ;;
    esac
    for state_value in \
        "$hub_present" "$hub_active" "$hub_enabled" \
        "$proxy_present" "$proxy_active" "$proxy_enabled" \
        "$telemetry_present" "$telemetry_active" "$telemetry_enabled"; do
        case "$state_value" in 0|1) ;; *) return 1 ;; esac
    done
}

wait_service_active() {
    checked_service=$1
    attempt=1
    while [ "$attempt" -le "$health_attempts" ]; do
        systemctl is-active --quiet "$checked_service" && return 0
        [ "$attempt" -eq "$health_attempts" ] || sleep "$health_delay"
        attempt=$((attempt + 1))
    done
    return 1
}

set_enabled_state() {
    configured_service=$1
    previous_present=$2
    previous_enabled=$3
    [ "$previous_present" = 1 ] && unit_available "$configured_service" || return 0
    if [ "$previous_enabled" = 1 ]; then
        systemctl enable "$configured_service"
    else
        systemctl disable "$configured_service"
    fi
}

stop_recorded_service() {
    configured_service=$1
    previous_present=$2
    previous_active=$3
    [ "$previous_present" = 1 ] && [ "$previous_active" = 0 ] \
        && unit_available "$configured_service" || return 0
    systemctl stop "$configured_service"
}

start_recorded_service() {
    configured_service=$1
    previous_present=$2
    previous_active=$3
    [ "$previous_present" = 1 ] && [ "$previous_active" = 1 ] \
        && unit_available "$configured_service" || return 0
    systemctl start "$configured_service" && wait_service_active "$configured_service"
}

stop_all_services() {
    [ -d /run/systemd/system ] || return 0
    systemctl stop "$fleet_telemetry_service" || true
    systemctl stop "$service" || true
    systemctl stop "$command_proxy_service" || true
}

hub_is_ready() {
    status=$(
        "$timeout_binary" "$health_timeout" "$runuser_binary" -u teslatlas -- \
            "$hub_binary" --config "$config_file" status 2>/dev/null
    ) || return 1
    printf '%s' "$status" | grep -Fq '"ready":true'
}

hub_preflight() {
    "$timeout_binary" "$preflight_timeout" "$runuser_binary" -u teslatlas -- \
        "$hub_binary" --config "$config_file" preflight >/dev/null 2>&1
}

hub_is_unconfigured() {
    status=$(
        "$timeout_binary" "$health_timeout" "$runuser_binary" -u teslatlas -- \
            "$hub_binary" --config "$config_file" status 2>/dev/null
    ) || return 1
    printf '%s' "$status" | grep -Fq '"vehicles":[]' || return 1
    "$timeout_binary" "$preflight_timeout" "$runuser_binary" -u teslatlas -- \
        "$hub_binary" --config "$config_file" doctor >/dev/null 2>&1
}

hub_bootstrap() {
    "$timeout_binary" "$bootstrap_timeout" "$runuser_binary" -u teslatlas -- \
        "$hub_binary" --config "$config_file" bootstrap >/dev/null 2>&1
}

ensure_offline_defaults() {
    [ -f "$config_file" ] && [ ! -L "$config_file" ] || return 0
    offline_tmp="${config_file}.teslatlas.$$"
    awk '
        function flush_default() {
            if (current != "" && !has_enabled) {
                print "enabled = false"
            }
        }
        {
            header = $0
            sub(/[[:space:]]*#.*/, "", header)
            sub(/^[[:space:]]*/, "", header)
            sub(/[[:space:]]*$/, "", header)
            if (header ~ /^\[\[?[^]]+\]\]?$/) {
                flush_default()
                current = ""
                has_enabled = 0
                if (header == "[geocoder]") {
                    current = "geocoder"
                    found_geocoder = 1
                } else if (header == "[terrain]") {
                    current = "terrain"
                    found_terrain = 1
                }
            }
            if (current != "" && $0 ~ /^[[:space:]]*enabled[[:space:]]*=/) {
                has_enabled = 1
            }
            print
        }
        END {
            flush_default()
            if (!found_geocoder) {
                print ""
                print "[geocoder]"
                print "enabled = false"
            }
            if (!found_terrain) {
                print ""
                print "[terrain]"
                print "enabled = false"
            }
        }
    ' "$config_file" > "$offline_tmp"
    mv -f "$offline_tmp" "$config_file"
}

remove_upgrade_backup() {
    [ ! -e "$backup_dir" ] && [ ! -L "$backup_dir" ] && return 0
    [ -d "$backup_dir" ] && [ ! -L "$backup_dir" ] || return 1
    find "$backup_dir" -depth -delete
}

restore_optional_file() {
    backup_name=$1
    destination=$2
    destination_mode=$3
    if [ -f "$backup_dir/$backup_name.absent" ] \
        && [ ! -L "$backup_dir/$backup_name.absent" ]; then
        rm -f "$destination"
        return 0
    fi
    [ -f "$backup_dir/$backup_name" ] && [ ! -L "$backup_dir/$backup_name" ] || return 1
    install -o root -g root -m "$destination_mode" "$backup_dir/$backup_name" "$destination"
}

restore_upgrade_payload() {
    [ -f "$backup_dir/teslatlas-hub" ] && [ ! -L "$backup_dir/teslatlas-hub" ] || return 1
    [ -f "$backup_dir/teslatlas-hub.service" ] \
        && [ ! -L "$backup_dir/teslatlas-hub.service" ] || return 1
    install -o root -g root -m 0755 "$backup_dir/teslatlas-hub" "$hub_binary"
    install -o root -g root -m 0644 "$backup_dir/teslatlas-hub.service" "$unit_file"
    restore_optional_file teslatlas-hub-terminal-failure.target "$terminal_failure_target_file" 0644
    restore_optional_file tesla-http-proxy "$command_proxy_binary" 0755
    restore_optional_file fleet-telemetry "$fleet_telemetry_binary" 0755
    restore_optional_file teslatlas-command-proxy.service "$command_proxy_unit_file" 0644
    restore_optional_file teslatlas-fleet-telemetry.service "$fleet_telemetry_unit_file" 0644
    restore_optional_file command-proxy.env "$command_proxy_config" 0644
    restore_optional_file fleet-telemetry.json "$fleet_telemetry_config" 0644
}

restore_service_state() {
    if [ ! -d /run/systemd/system ]; then
        rm -f "$state_file"
        return 0
    fi
    restored=1
    systemctl daemon-reload || restored=0

    [ -f "$state_file" ] || return 0
    read_service_state || return 1

    set_enabled_state "$service" "$hub_present" "$hub_enabled" || restored=0
    set_enabled_state "$command_proxy_service" "$proxy_present" "$proxy_enabled" || restored=0
    set_enabled_state "$fleet_telemetry_service" "$telemetry_present" "$telemetry_enabled" || restored=0

    stop_recorded_service "$fleet_telemetry_service" "$telemetry_present" "$telemetry_active" \
        || restored=0
    stop_recorded_service "$service" "$hub_present" "$hub_active" || restored=0
    stop_recorded_service "$command_proxy_service" "$proxy_present" "$proxy_active" \
        || restored=0

    start_recorded_service "$command_proxy_service" "$proxy_present" "$proxy_active" \
        || restored=0
    start_recorded_service "$service" "$hub_present" "$hub_active" || restored=0
    start_recorded_service "$fleet_telemetry_service" "$telemetry_present" "$telemetry_active" \
        || restored=0
    [ "$restored" = 1 ] && rm -f "$state_file"
    [ "$restored" = 1 ]
}

rollback_upgrade() {
    reason=$1
    stop_all_services
    if restore_upgrade_payload && restore_service_state; then
        remove_upgrade_backup || true
        echo "$reason; restored the installed Teslatlas Hub" >&2
    else
        echo "$reason; automatic rollback failed, retained $backup_dir" >&2
    fi
    exit 1
}

retain_forward_only_stopped() {
    retained=1
    if [ -d /run/systemd/system ]; then
        stop_all_services || retained=0
        systemctl daemon-reload || retained=0
        if [ -f "$state_file" ]; then
            read_service_state || retained=0
            if [ "$retained" = 1 ]; then
                set_enabled_state "$service" "$hub_present" "$hub_enabled" || retained=0
                set_enabled_state "$command_proxy_service" "$proxy_present" "$proxy_enabled" \
                    || retained=0
                set_enabled_state "$fleet_telemetry_service" "$telemetry_present" \
                    "$telemetry_enabled" || retained=0
            fi
        fi
    fi
    if [ "$retained" = 1 ]; then
        rm -f "$state_file"
        remove_upgrade_backup || retained=0
    fi
    [ "$retained" = 1 ]
}

fail_forward_only() {
    reason=$1
    if retain_forward_only_stopped; then
        echo "TESLATLAS_FORWARD_ONLY_UPGRADE: $reason; new Hub retained stopped" >&2
    else
        echo "TESLATLAS_FORWARD_ONLY_UPGRADE: $reason; cleanup incomplete at $backup_dir" >&2
    fi
    exit 1
}

begin_forward_only() {
    forward_only=1
    if [ -d "$backup_dir" ] && [ ! -L "$backup_dir" ]; then
        install -o root -g root -m 0600 /dev/null "$backup_dir/forward-only"
    fi
}

fail_upgrade() {
    reason=$1
    if [ "$forward_only" = 1 ] \
        || { [ -f "$backup_dir/forward-only" ] && [ ! -L "$backup_dir/forward-only" ]; }; then
        fail_forward_only "$reason"
    fi
    if [ -d "$backup_dir" ] && [ ! -L "$backup_dir" ]; then
        rollback_upgrade "$reason"
    fi
    echo "$reason; service remains stopped" >&2
    exit 1
}

case "${1:-}" in
    abort-remove|abort-deconfigure|abort-upgrade)
        if [ "${1:-}" = abort-upgrade ] && [ -d "$backup_dir" ]; then
            if [ -f "$backup_dir/forward-only" ] && [ ! -L "$backup_dir/forward-only" ]; then
                retain_forward_only_stopped || exit 1
                exit 0
            else
                restore_upgrade_payload || exit 1
                remove_upgrade_backup || exit 1
            fi
        fi
        restore_service_state || exit 1
        exit 0
        ;;
esac

if ! getent passwd teslatlas >/dev/null 2>&1; then
    adduser --system --group --home /var/lib/teslatlas-hub --no-create-home teslatlas
fi

install -d -o teslatlas -g teslatlas -m 0700 /var/lib/teslatlas-hub
install -d -o root -g teslatlas -m 0750 /etc/teslatlas-hub
if [ -e "$config_file" ] || [ -L "$config_file" ]; then
    [ -f "$config_file" ] && [ ! -L "$config_file" ] || {
        echo "Teslatlas Hub configuration is not a regular file" >&2
        exit 1
    }
    ensure_offline_defaults
    chown root:teslatlas "$config_file"
    chmod 0640 "$config_file"
fi

if [ "${1:-}" = configure ] && [ -n "${2:-}" ] && ! hub_preflight; then
    begin_forward_only
    hub_bootstrap || fail_upgrade "schema migration failed"
    hub_preflight || hub_is_unconfigured \
        || fail_upgrade "migrated Hub failed read-only admission"
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    if [ "${1:-}" = configure ] && [ -n "${2:-}" ]; then
        if [ -f "$state_file" ]; then
            read_service_state || fail_upgrade "saved service state is invalid"
        else
            hub_present=1
            hub_active=0
            hub_enabled=0
            proxy_present=0
            proxy_active=0
            proxy_enabled=0
            telemetry_present=0
            telemetry_active=0
            telemetry_enabled=0
            systemctl is-active --quiet "$service" && hub_active=1
        fi

        stop_recorded_service "$fleet_telemetry_service" "$telemetry_present" \
            "$telemetry_active" || fail_upgrade "Fleet Telemetry service could not remain stopped"
        stop_recorded_service "$service" "$hub_present" "$hub_active" \
            || fail_upgrade "Hub service could not remain stopped"
        stop_recorded_service "$command_proxy_service" "$proxy_present" "$proxy_active" \
            || fail_upgrade "command proxy could not remain stopped"

        start_recorded_service "$command_proxy_service" "$proxy_present" "$proxy_active" \
            || fail_upgrade "command proxy failed its bounded startup check"

        if [ "$hub_active" = 1 ]; then
            systemctl start "$service" || fail_upgrade "New Hub failed to start"
        else
            systemctl stop "$service" || true
        fi
        if [ "$hub_active" = 1 ]; then
            attempt=1
            ready=0
            while [ "$attempt" -le "$health_attempts" ]; do
                systemctl is-active --quiet "$service" || {
                    fail_upgrade "New Hub failed to remain active"
                }
                if hub_is_ready || hub_is_unconfigured; then
                    ready=1
                    break
                fi
                [ "$attempt" -eq "$health_attempts" ] || sleep "$health_delay"
                attempt=$((attempt + 1))
            done
            if [ "$ready" != 1 ]; then
                fail_upgrade "New Hub did not become ready"
            fi
        fi

        start_recorded_service "$fleet_telemetry_service" "$telemetry_present" \
            "$telemetry_active" || fail_upgrade "Fleet Telemetry failed its bounded startup check"
    fi
fi

if [ "${1:-}" = configure ]; then
    rm -f "$state_file"
    remove_upgrade_backup || true
fi
