[Unit]
Description=Teslatlas Hub
After=network-online.target
Wants=network-online.target teslatlas-command-proxy.service teslatlas-fleet-telemetry.service
OnFailure=teslatlas-hub-terminal-failure.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=teslatlas
Group=teslatlas
StateDirectory=teslatlas-hub
StateDirectoryMode=0700
ExecStart=/usr/bin/teslatlas-hub --config /etc/teslatlas-hub/config.toml serve
Restart=always
RestartMode=direct
RestartSec=5
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/teslatlas-hub
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
