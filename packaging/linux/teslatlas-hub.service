[Unit]
Description=Teslatlas Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teslatlas
Group=teslatlas
ExecStart=/usr/bin/teslatlas-hub --config /etc/teslatlas-hub/config.toml serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/teslatlas-hub

[Install]
WantedBy=multi-user.target
