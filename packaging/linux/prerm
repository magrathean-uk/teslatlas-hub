#!/bin/sh
set -eu

service=teslatlas-hub.service
state_file=${TESLATLAS_HUB_MAINTAINER_STATE_FILE:-/run/teslatlas-hub-maintainer.state}

record_service_state() {
    [ ! -e "$state_file" ] && [ ! -L "$state_file" ] || return 0

    was_active=0
    was_enabled=0
    systemctl is-active --quiet "$service" && was_active=1
    systemctl is-enabled --quiet "$service" && was_enabled=1

    state_tmp="${state_file}.$$"
    if ! (umask 077 && printf '%s %s\n' "$was_active" "$was_enabled" > "$state_tmp"); then
        rm -f "$state_tmp"
        return 1
    fi
    if ! mv -f "$state_tmp" "$state_file"; then
        rm -f "$state_tmp"
        return 1
    fi
}

case "${1:-}" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            record_service_state
            systemctl stop "$service" || true
            systemctl disable "$service" || true
        fi
        ;;
esac
