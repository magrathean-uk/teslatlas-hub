# Add the three key/certificate files, then enable teslatlas-command-proxy.service.
TESLA_KEY_FILE=/etc/teslatlas-hub/command-auth-private.pem
TESLA_HTTP_PROXY_TLS_CERT=/etc/teslatlas-hub/command-proxy-cert.pem
TESLA_HTTP_PROXY_TLS_KEY=/etc/teslatlas-hub/command-proxy-tls-key.pem
TESLA_HTTP_PROXY_HOST=127.0.0.1
TESLA_HTTP_PROXY_PORT=4445
TESLA_CACHE_FILE=/var/lib/teslatlas-hub/command-proxy-session-cache.json
