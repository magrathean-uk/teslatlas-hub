{
  "host": "0.0.0.0",
  "port": 443,
  "status_port": 0,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesatlas",
  "tesatlas": {
    "timeout_ms": 2000
  },
  "reliable_ack_sources": {
    "V": "tesatlas"
  },
  "records": {
    "V": ["tesatlas"],
    "connectivity": ["tesatlas"]
  },
  "tls": {
    "server_cert": "/etc/tesatlas-hub/tls.crt",
    "server_key": "/etc/tesatlas-hub/tls.key"
  }
}
