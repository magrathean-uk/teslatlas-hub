[Unit]
Description=Teslatlas Fleet Telemetry bridge
After=network-online.target teslatlas-hub.service
Wants=network-online.target
PartOf=teslatlas-hub.service
StartLimitIntervalSec=300
StartLimitBurst=5
ConditionPathExists=/var/lib/teslatlas-hub/fleet-telemetry-bearer
ConditionPathExists=/etc/teslatlas-hub/tls.crt
ConditionPathExists=/etc/teslatlas-hub/tls.key

[Service]
Type=simple
User=teslatlas
Group=teslatlas
Environment=TESLATLAS_FLEET_TELEMETRY_BEARER_FILE=/var/lib/teslatlas-hub/fleet-telemetry-bearer
StateDirectory=teslatlas-hub
StateDirectoryMode=0700
ExecStart=/usr/lib/teslatlas-hub/fleet-telemetry -config=/etc/teslatlas-hub/fleet-telemetry.json
Restart=on-failure
RestartSec=5
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/teslatlas-hub
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
