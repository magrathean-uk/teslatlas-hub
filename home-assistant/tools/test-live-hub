#!/bin/sh
set -eu

: "${TESATLAS_HA_LIVE_READY:?TESATLAS_HA_LIVE_READY is required}"
: "${TESATLAS_HA_LIVE_INVITATION:?TESATLAS_HA_LIVE_INVITATION is required}"
: "${TESATLAS_HA_LIVE_SCENARIO:?TESATLAS_HA_LIVE_SCENARIO is required}"
: "${TESATLAS_HA_LIVE_RECEIPT:?TESATLAS_HA_LIVE_RECEIPT is required}"
: "${TESATLAS_HA_LIVE_INITIAL:?TESATLAS_HA_LIVE_INITIAL is required}"
: "${TESATLAS_HA_LIVE_CONTINUE:?TESATLAS_HA_LIVE_CONTINUE is required}"
: "${TESATLAS_HA_LIVE_REAUTH_INVITATION:?TESATLAS_HA_LIVE_REAUTH_INVITATION is required}"
: "${TESATLAS_HA_LIVE_REAUTH_READY:?TESATLAS_HA_LIVE_REAUTH_READY is required}"
: "${TESATLAS_HA_LIVE_REAUTH_REQUEST:?TESATLAS_HA_LIVE_REAUTH_REQUEST is required}"
: "${TESATLAS_HA_LIVE_REAUTH_CONTINUE:?TESATLAS_HA_LIVE_REAUTH_CONTINUE is required}"
: "${SSL_CERT_FILE:?SSL_CERT_FILE must name the isolated fixture CA}"
: "${REQUESTS_CA_BUNDLE:?REQUESTS_CA_BUNDLE must name the same isolated fixture CA for Home Assistant}"
: "${TESATLAS_HA_SYSTEM_CA:?TESATLAS_HA_SYSTEM_CA is required for the trust-negative check}"

test "$SSL_CERT_FILE" = "$REQUESTS_CA_BUNDLE"

export TESATLAS_HA_LIVE=1
export PYTHONDONTWRITEBYTECODE=1
exec .venv/bin/python -B -m pytest -q --no-showlocals -p no:cacheprovider \
  tests/integration/test_live_hub.py::test_installed_config_entry_polls_and_unloads_real_hub
