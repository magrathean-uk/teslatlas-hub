#!/bin/sh
set -eu

ssh_config=${TESLATLAS_MAC_SSH_CONFIG:-"$HOME/dev/teslatlas-lab/access/ssh_config"}
ssh_alias=${TESLATLAS_MAC_SSH_ALIAS:-teslatlas-debian13-arm64}
local_port=${TESLATLAS_MAC_HA_PORT:-18123}

test -f "$ssh_config" || {
  printf '%s\n' "SSH config not found: $ssh_config" >&2
  exit 2
}

case "$local_port" in
  ''|*[!0-9]*|0)
    printf '%s\n' "TESLATLAS_MAC_HA_PORT must be an integer from 1 to 65535" >&2
    exit 2
    ;;
esac

if [ "$local_port" -gt 65535 ]; then
  printf '%s\n' "TESLATLAS_MAC_HA_PORT must be an integer from 1 to 65535" >&2
  exit 2
fi

exec ssh \
  -F "$ssh_config" \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -N \
  -L "127.0.0.1:${local_port}:127.0.0.1:8123" \
  "$ssh_alias"
