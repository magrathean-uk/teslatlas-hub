{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teslatlas:protocol:schema:conformance:1.2.0",
  "title": "Teslatlas language-neutral conformance artifacts",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/case"
    }
  ],
  "$defs": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$",
      "maxLength": 96
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runner_protocol",
        "current_version",
        "supported_profiles",
        "profiles"
      ],
      "properties": {
        "kind": {
          "const": "manifest"
        },
        "runner_protocol": {
          "const": "teslatlas-conformance/1"
        },
        "current_version": {
          "$ref": "urn:teslatlas:protocol:schema:common:1.2.0#/$defs/semver"
        },
        "supported_profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:teslatlas:protocol:schema:common:1.2.0#/$defs/semver"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "path"
            ],
            "properties": {
              "version": {
                "$ref": "urn:teslatlas:protocol:schema:common:1.2.0#/$defs/semver"
              },
              "path": {
                "type": "string",
                "pattern": "^compatibility/[0-9]+\\.[0-9]+\\.[0-9]+/profile\\.json$"
              }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol_version",
        "extends",
        "capabilities",
        "cases"
      ],
      "properties": {
        "kind": {
          "const": "profile"
        },
        "protocol_version": {
          "$ref": "urn:teslatlas:protocol:schema:common:1.2.0#/$defs/semver"
        },
        "extends": {
          "oneOf": [
            {
              "$ref": "urn:teslatlas:protocol:schema:common:1.2.0#/$defs/semver"
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/case_id"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "case_id",
        "introduced_in",
        "capability",
        "description",
        "steps"
      ],
      "properties": {
        "kind": {
          "const": "case"
        },
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "introduced_in": {
          "$ref": "urn:teslatlas:protocol:schema:common:1.2.0#/$defs/semver"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "adapter_request_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "profile",
        "case_id",
        "step_id",
        "capability",
        "request"
      ],
      "properties": {
        "protocol": {
          "const": "teslatlas-conformance/1"
        },
        "profile": {
          "$ref": "urn:teslatlas:protocol:schema:common:1.2.0#/$defs/semver"
        },
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "request": {
          "$ref": "#/$defs/request"
        }
      }
    },
    "adapter_response_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "step_id",
        "response"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "response": {
          "allOf": [
            {
              "$ref": "#/$defs/response"
            },
            {
              "not": {
                "required": [
                  "body_file"
                ]
              }
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "request",
        "expect",
        "reference_response"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        },
        "reference_response": {
          "$ref": "#/$defs/response"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "headers",
        "query"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "headers": {
          "$ref": "#/$defs/string_map"
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "body": {},
        "body_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers_present": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "headers_equal": {
          "$ref": "#/$defs/string_map"
        },
        "body_absent": {
          "type": "boolean"
        },
        "body_schema": {
          "type": "string",
          "format": "uri"
        },
        "event_schema": {
          "type": "string",
          "format": "uri"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "op"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "op": {
          "enum": [
            "equals",
            "exists",
            "not_equals",
            "same_as",
            "not_same_as",
            "matches",
            "is_empty",
            "is_not_empty",
            "unique"
          ]
        },
        "value": {},
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "headers"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "$ref": "#/$defs/string_map"
        },
        "body": {},
        "body_file": {
          "type": "string",
          "pattern": "^(examples|fixtures)/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/normalized_event"
          }
        },
        "last_event_id_after": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "body",
          "body_file"
        ]
      }
    },
    "normalized_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "data": {
          "$ref": "urn:teslatlas:protocol:schema:event:1.2.0"
        }
      }
    },
    "string_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
