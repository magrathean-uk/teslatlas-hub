{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teslatlas.dev/schemas/build-input-manifest-v2.json",
  "title": "Exact snapshot-derived build inputs and complete retained exports",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "build_id", "members", "export_roots", "exports"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "build_id": {"type": "string", "minLength": 1},
    "members": {"type": "array", "minItems": 1, "maxItems": 250000, "items": {"$ref": "#/$defs/input_member"}},
    "export_roots": {"type": "array", "maxItems": 250000, "items": {"$ref": "#/$defs/export_root"}},
    "exports": {"type": "array", "maxItems": 250000, "items": {"$ref": "#/$defs/export"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"type": "string", "pattern": "^0[0-7]{3}$"},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "type", "mode", "bytes", "sha256", "symlink_target"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "type": {"enum": ["file", "symlink", "directory"]},
        "mode": {"$ref": "#/$defs/mode"}, "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "symlink_target": {"type": ["string", "null"]}
      }
    },
    "input_member": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "root", "path", "type", "mode", "bytes", "sha256", "symlink_target", "git_ignored", "retained_input"],
      "properties": {
        "role": {"type": "string", "minLength": 1}, "root": {"type": "string", "pattern": "^/"},
        "path": {"type": "string", "minLength": 1}, "type": {"enum": ["file", "symlink"]},
        "mode": {"$ref": "#/$defs/mode"}, "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}, "symlink_target": {"type": ["string", "null"]},
        "git_ignored": {"type": "boolean"},
        "retained_input": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}
      },
      "allOf": [{
        "if": {"properties": {"git_ignored": {"const": true}}},
        "then": {"properties": {"retained_input": {"$ref": "#/$defs/binding"}}},
        "else": {"properties": {"retained_input": {"type": "null"}}}
      }]
    },
    "export_root": {
      "type": "object", "additionalProperties": false, "required": ["role", "path", "mode", "members"],
      "properties": {
        "role": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/"},
        "mode": {"$ref": "#/$defs/mode"},
        "members": {"type": "array", "minItems": 1, "maxItems": 250000, "items": {"$ref": "#/$defs/member"}}
      }
    },
    "export": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "export_root", "source_role", "source_path", "type", "mode", "bytes", "sha256", "symlink_target"],
      "properties": {
        "role": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/"},
        "export_root": {"type": "string", "minLength": 1},
        "source_role": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1},
        "type": {"enum": ["file", "symlink"]}, "mode": {"$ref": "#/$defs/mode"},
        "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"},
        "symlink_target": {"type": ["string", "null"]}
      }
    }
  }
}
